{
  "name": "watershed-website",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "predev": "cd .. && gleam build --target javascript && cd watershed_lustre && gleam build --target javascript",
    "dev": "astro dev",
    "prebuild": "cd .. && gleam build --target javascript && cd watershed_lustre && gleam build --target javascript",
    "build": "astro build",
    "preview": "astro preview",
    "og:image": "node scripts/og-image.mjs",
    "test:rich-text-adapter": "node --test src/scripts/demo/rich-text-adapter.test.mjs",
    "test:demo-boot": "node --test src/scripts/demo/boot.test.mjs",
    "test:snippet": "node --strip-types --test src/lib/snippet.test.ts",
    "test:snippet-markers": "node --strip-types --test src/lib/snippet-markers.test.ts",
    "test:guide-race-styles": "node scripts/check-guide-race-styles.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "astro": "^7.1.0",
    "astro-tinylytics": "^0.1.0",
    "quill": "2.0.3",
    "quill-cursors": "4.0.4",
    "rough-notation": "^0.5.1"
  },
  "devDependencies": {
    "puppeteer-core": "^25.3.0"
  }
