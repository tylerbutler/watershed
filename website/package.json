{
  "name": "watershed-website",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "generate:snippets": "cd ../tools/source-snippets && gleam run -m source_snippets/cli -- ../../website/snippets.json ../../website/src/generated/snippets.json",
    "predev": "cd .. && gleam build --target javascript && cd watershed_lustre && gleam build --target javascript && cd ../website && pnpm generate:snippets",
    "dev": "astro dev",
    "prebuild": "cd .. && gleam build --target javascript && cd watershed_lustre && gleam build --target javascript && cd ../website && pnpm generate:snippets && node --strip-types --test src/data/drift-gates.test.ts && node --strip-types --test src/data/copy-gates.test.ts",
    "build": "astro build",
    "preview": "astro preview",
    "og:image": "node scripts/og-image.mjs",
    "test:rich-text-adapter": "node --test src/scripts/demo/rich-text-adapter.test.mjs",
    "test:demo-boot": "node --test src/scripts/demo/boot.test.mjs",
    "test:snippet": "node --strip-types --test src/lib/snippet.test.ts",
    "test:snippet-manifest": "node --strip-types --test src/lib/snippet-manifest.test.ts",
    "test:practice-snippets": "node --strip-types --test src/data/practice-snippets.test.ts",
    "test:standalone-snippets": "node --strip-types --test src/data/standalone-snippets.test.ts",
    "test:drift-gates": "node --strip-types --test src/data/drift-gates.test.ts",
    "test:copy-gates": "node --strip-types --test src/data/copy-gates.test.ts",
    "test:global-styles": "node --test src/styles/global.test.mjs",
    "test:guide-race-styles": "node scripts/check-guide-race-styles.mjs",
    "test:netlify-contract": "node scripts/netlify-deploy-contract.test.mjs",
    "test:snippet-config": "node scripts/snippet-config.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "astro": "^7.1.0",
    "astro-tinylytics": "^0.1.0",
    "quill": "2.0.3",
    "quill-cursors": "4.0.4",
    "rough-notation": "^0.5.1"
  },
  "devDependencies": {
    "puppeteer-core": "^25.3.0"
  }
}
