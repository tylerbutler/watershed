---
import Sheet from "../layouts/Sheet.astro";
import TextDemo from "../components/TextDemo.astro";
import TextElementDemo from "../components/TextElementDemo.astro";
import Ecosystem from "../components/Ecosystem.astro";
---

<Sheet
  title="watershed — SharedText demo"
  description="Three browser clients type into one string through watershed's compiled text_kernel: a CRDT text where every grapheme keeps a stable identity, so concurrent insertions and overlapping edits merge without fighting over character offsets. Grapheme indexing, optimistic edits, anchors, server-sequenced convergence."
>
  <header class="page-hero">
    <div class="page-hero-inner">
      <p class="eyebrow annot">
        <a href="/structures/sequences">← Sequences</a> · SharedText
      </p>
      <h1>Graphemes keep<br /><em>their place.</em></h1>
      <p class="lede">
        A character offset only means something against one version of a
        string. After two people edit the same word, “index 6” can identify
        different characters on different screens.
        <strong>SharedText</strong> gives every grapheme a stable identity
        in addition to its index. You specify <em>insert at 6</em> or
        <em>replace 0..5</em>, but the delta identifies graphemes instead of
        offsets. Concurrent inserts remain, and overlapping edits merge.
        Indices count <strong>graphemes</strong>, not UTF-16 code units. Thus,
        an emoji or combining accent remains one character. watershed’s
        <code>text_kernel</code> gives each replica the same text.
      </p>
      <div class="cta-row">
        <a class="cta-quiet" href="#text-demo">Jump to the demo ↓</a>
        <a class="cta-quiet" href="/rich-text">Compare SharedRichText →</a>
        <a class="cta-quiet" href="https://github.com/tylerbutler/watershed">
          Read the source
        </a>
      </div>
    </div>
  </header>

  <main>
    <TextDemo />
    <TextElementDemo />
  </main>
  <Ecosystem />
</Sheet>

<script>
  import { initReveals } from "../scripts/motion.js";
  initReveals();
</script>

<style>
  .page-hero {
    padding: clamp(3.5rem, 9vw, 7.5rem) var(--content-pad)
      clamp(2.5rem, 6vw, 5rem);
    border-bottom: 1px solid var(--hairline);
  }

  .page-hero-inner {
    max-width: 68rem;
    margin-inline: auto;
  }

  .eyebrow {
    color: var(--muted);
    margin: 0 0 var(--space-lg);
  }

  .eyebrow a {
    color: var(--waterline);
    text-decoration: none;
  }

  .eyebrow a:hover {
    color: var(--overprint-deep);
  }

  h1 {
    font-size: var(--text-display);
    font-weight: 640;
    font-stretch: 122%;
    line-height: 0.99;
    letter-spacing: -0.025em;
    max-width: 16ch;
  }

  h1 em {
    font-style: normal;
    color: var(--overprint-deep);
  }

  .lede {
    margin-top: var(--space-xl);
    font-size: clamp(1.125rem, 0.6vw + 1rem, 1.3125rem);
    line-height: 1.6;
    max-width: 56ch;
    color: var(--ink);
  }

  .cta-row {
    margin-top: var(--space-xl);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-lg);
  }

  .cta-quiet {
    font-weight: 500;
    color: var(--waterline);
  }
</style>
