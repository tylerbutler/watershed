---
import Sheet from "../layouts/Sheet.astro";
import CounterBug from "../components/CounterBug.astro";
import Ecosystem from "../components/Ecosystem.astro";
---

<Sheet
  title="watershed: prevent lost counter updates"
  description="This live example shows how a last-write-wins SharedMap loses concurrent counter updates. SharedCounter preserves both increments."
>
  <header class="page-hero">
    <div class="page-hero-inner">
      <p class="eyebrow annot">
        <a href="/#demo">← watershed</a> · SharedMap · common configuration error
      </p>
      <h1>Store counts in a<br /><em>counter structure.</em></h1>
      <p class="lede">
        SharedMap selects the write with the higher server sequence number for
        each key. All replicas get the same value. One read-modify-write
        operation can still overwrite another. If two clients read the same
        count and each writes <code>count + 1</code>, both submit the same
        replacement value. The later write adds nothing. This demo runs
        watershed's compiled <code>map_kernel</code>.
      </p>
      <div class="cta-row">
        <a class="cta-quiet" href="#counter-bug">View the error ↓</a>
        <a class="cta-quiet" href="/structures/counters">Use SharedCounter →</a>
      </div>
    </div>
  </header>

  <main>
    <CounterBug />
  </main>
  <Ecosystem />
</Sheet>

<script>
  import { initReveals } from "../scripts/motion.js";
  initReveals();
</script>

<style>
  .page-hero {
    padding: clamp(3.5rem, 9vw, 7.5rem) var(--content-pad)
      clamp(2.5rem, 6vw, 5rem);
    border-bottom: 1px solid var(--hairline);
  }

  .page-hero-inner {
    max-width: 68rem;
    margin-inline: auto;
  }

  .eyebrow {
    color: var(--muted);
    margin: 0 0 var(--space-lg);
  }

  .eyebrow a {
    color: var(--waterline);
    text-decoration: none;
  }

  .eyebrow a:hover {
    color: var(--overprint-deep);
  }

  h1 {
    font-size: var(--text-display);
    font-weight: 640;
    font-stretch: 122%;
    line-height: 0.99;
    letter-spacing: -0.025em;
    max-width: 16ch;
  }

  h1 em {
    font-style: normal;
    color: var(--overprint-deep);
  }

  .lede {
    margin-top: var(--space-xl);
    font-size: clamp(1.125rem, 0.6vw + 1rem, 1.3125rem);
    line-height: 1.6;
    max-width: 56ch;
    color: var(--ink);
  }

  .lede code {
    font-size: 0.9em;
    color: var(--overprint-deep);
  }

  .cta-row {
    margin-top: var(--space-xl);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-lg);
  }

  .cta-quiet {
    font-weight: 500;
    color: var(--waterline);
  }
</style>
