---
import Sheet from "../layouts/Sheet.astro";
import Ecosystem from "../components/Ecosystem.astro";
import {
  examplesForPattern,
  patterns,
} from "../data/examples";
---

<Sheet
  title="watershed — application patterns"
  description="Patterns extracted from watershed's browser examples: ready-gated bootstrap, typed document shapes, subscriptions, conflict-first modeling, component boundaries, transient signals, pending state, and convergence tests."
>
  <header class="p-hero">
    <div class="p-hero-inner">
      <p class="p-crumbs annot"><a href="/">&#8592; watershed</a> / Patterns</p>
      <h1>The shapes that keep<br />collaboration honest.</h1>
      <p class="p-lede">
        Thirteen browser applications, reduced to the conventions that recur.
        These are not framework commandments: each pattern appears in several
        checked-in examples and solves a boundary that distributed UI makes
        easy to blur.
      </p>
      <div class="p-actions">
        <a class="cta-primary" href="#reference">Read the reference &#8595;</a>
        <a class="cta-quiet" href="/examples">Browse all examples &#8594;</a>
      </div>
    </div>
  </header>

  <main id="reference" class="p-main">
    <nav class="p-index" aria-label="Application patterns">
      <p class="annot">Field index</p>
      <ol>
        {
          patterns.map((pattern) => (
            <li>
              <a href={`#${pattern.id}`}>
                <span>{pattern.title}</span>
                <span aria-hidden="true">&#8595;</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="p-reference">
      {
        patterns.map((pattern) => {
          const evidence = examplesForPattern(pattern.id);
          return (
            <section id={pattern.id} class="p-pattern">
              <header>
                <h2>{pattern.title}</h2>
                <p class="p-rule">{pattern.rule}</p>
              </header>
              <div class="p-detail">
                <div>
                  <h3>Why it holds</h3>
                  <p>{pattern.why}</p>
                </div>
                <div>
                  <h3>Use it when</h3>
                  <p>{pattern.useWhen}</p>
                </div>
              </div>
              <div class="p-evidence">
                <span class="annot">Observed in {evidence.length} examples</span>
                <ul>
                  {
                    evidence.slice(0, 5).map((example) => (
                      <li>
                        <a href={`/examples#${example.id}`}>{example.name}</a>
                      </li>
                    ))
                  }
                </ul>
                {
                  evidence.length > 5 && (
                    <a class="p-more" href="/examples#catalog">
                      See all {evidence.length} in the gallery &#8594;
                    </a>
                  )
                }
              </div>
            </section>
          );
        })
      }
    </div>
  </main>

  <aside class="p-boundary" aria-labelledby="p-boundary-title">
    <div>
      <h2 id="p-boundary-title">A pattern is not an abstraction quota.</h2>
      <p>
        The examples repeat boundaries, not boilerplate. Reuse the lifecycle
        and ownership rules; keep domain-specific state and views close to the
        app that needs them.
      </p>
      <a href="/examples">Choose an example to trace &#8594;</a>
    </div>
  </aside>

  <Ecosystem />
</Sheet>

<style>
  .p-hero {
    padding: clamp(3.5rem, 9vw, 7rem) var(--content-pad)
      clamp(2.5rem, 6vw, 5rem);
    border-bottom: 1px solid var(--hairline);
  }

  .p-hero-inner,
  .p-main,
  .p-boundary > div {
    max-width: 72rem;
    margin-inline: auto;
  }

  .p-crumbs {
    margin-bottom: var(--space-lg);
  }

  .p-crumbs a {
    text-decoration: none;
  }

  h1 {
    max-width: 18ch;
    font-size: var(--text-display);
    font-weight: 640;
    font-stretch: 122%;
    line-height: 0.99;
    letter-spacing: -0.025em;
  }

  .p-lede {
    margin-top: var(--space-xl);
    max-width: 60ch;
    font-size: clamp(1.125rem, 0.6vw + 1rem, 1.3125rem);
    line-height: 1.6;
  }

  .p-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-lg);
    margin-top: var(--space-2xl);
  }

  .cta-primary {
    display: inline-block;
    padding: 0.8rem 1.6rem;
    background: var(--overprint);
    color: var(--bg);
    text-decoration: none;
    font-weight: 600;
    font-stretch: 110%;
    transition: background var(--dur-feedback) var(--ease-out-quart);
  }

  .cta-primary:hover {
    background: var(--overprint-deep);
    color: var(--bg);
  }

  .cta-quiet {
    font-weight: 500;
    text-decoration: none;
  }

  .p-main {
    display: grid;
    grid-template-columns: minmax(12rem, 0.3fr) minmax(0, 1fr);
    gap: clamp(var(--space-xl), 6vw, 6rem);
    padding: var(--space-2xl) var(--content-pad) var(--space-section);
  }

  .p-index {
    align-self: start;
    position: sticky;
    top: var(--space-lg);
  }

  .p-index > p {
    color: var(--overprint-deep);
  }

  .p-index ol {
    list-style: none;
    margin: var(--space-md) 0 0;
    padding: 0;
    border-top: 1px solid var(--ink);
  }

  .p-index li {
    border-bottom: 1px solid var(--hairline);
  }

  .p-index a {
    display: flex;
    justify-content: space-between;
    gap: var(--space-sm);
    padding: 0.7rem 0;
    color: var(--muted);
    text-decoration: none;
    font-size: var(--text-sm);
    line-height: 1.35;
  }

  .p-index a:hover {
    color: var(--overprint-deep);
  }

  .p-reference {
    min-width: 0;
  }

  .p-pattern {
    scroll-margin-top: var(--space-lg);
    padding-bottom: var(--space-2xl);
    border-bottom: 1px solid var(--ink);
  }

  .p-pattern + .p-pattern {
    padding-top: var(--space-2xl);
  }

  .p-pattern h2,
  .p-boundary h2 {
    max-width: 24ch;
    font-size: var(--text-h2);
    font-weight: 620;
    font-stretch: 118%;
    line-height: 1.06;
    letter-spacing: -0.015em;
  }

  .p-rule {
    margin-top: var(--space-md);
    max-width: 58ch;
    font-size: 1.15rem;
    line-height: 1.55;
  }

  .p-detail {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-xl);
    margin-top: var(--space-xl);
  }

  .p-detail h3 {
    font-size: var(--text-sm);
    font-family: var(--font-mono);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--overprint-deep);
  }

  .p-detail p {
    margin-top: var(--space-xs);
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .p-evidence {
    margin-top: var(--space-xl);
    padding: var(--space-lg);
    border: 1px solid var(--hairline);
    background: var(--surface);
  }

  .p-evidence > .annot {
    color: var(--ink);
  }

  .p-evidence ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-lg);
    list-style: none;
    margin: var(--space-sm) 0 0;
    padding: 0;
  }

  .p-evidence a {
    font-size: var(--text-sm);
  }

  .p-more {
    display: inline-block;
    margin-top: var(--space-sm);
  }

  .p-boundary {
    padding: var(--space-2xl) var(--content-pad);
    border-block: 1px solid var(--ink);
    background:
      repeating-linear-gradient(
        -45deg,
        transparent,
        transparent 8px,
        var(--hairline-faint) 8px,
        var(--hairline-faint) 9px
      ),
      var(--surface);
  }

  .p-boundary > div {
    padding: var(--space-xl);
    background: var(--bg);
    border: 1px solid var(--ink);
  }

  .p-boundary p {
    margin-top: var(--space-md);
  }

  .p-boundary a {
    display: inline-block;
    margin-top: var(--space-lg);
    font-weight: 600;
  }

  @media (max-width: 48rem) {
    .p-main {
      grid-template-columns: 1fr;
    }

    .p-index {
      position: static;
    }
  }

  @media (max-width: 34rem) {
    h1 {
      font-size: clamp(2rem, 10vw, 3rem);
      font-stretch: 105%;
    }

    .p-detail {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }
</style>
