---
import Sheet from "../layouts/Sheet.astro";
import Hero from "../components/Hero.astro";
import Demo from "../components/Demo.astro";
import DdsSections from "../components/DdsSections.astro";
import AtlasCta from "../components/AtlasCta.astro";
import Architecture from "../components/Architecture.astro";
import Rigor from "../components/Rigor.astro";
import CodeSample from "../components/CodeSample.astro";
import Ecosystem from "../components/Ecosystem.astro";
---

<Sheet
  title="watershed: collaborative data structures for Gleam"
  description="watershed provides collaborative data structures for Gleam. It supports local edits before confirmation, server sequencing, reconnection, CRDTs, and operational transform on the BEAM and in the browser."
>
  <Hero />
  <main>
    <Demo views={["map"]} initial="map" showPicker={false}>
      <Fragment slot="intro">
        <p>
          On a revised survey sheet, magenta marks updates that workers have not
          checked in the field. This demo uses the same color code. Unconfirmed
          edits are <strong class="k-pending">magenta</strong>, and confirmed
          state is <strong class="k-seq">ink</strong>. All three clients run
          watershed’s compiled <code>map_kernel</code> Gleam code. They share
          one ordered list of changes. This structure is a shared map.
        </p>
        <p class="demo-hint">
          Change a gauge, make two clients write at once, or increase the network
          delay. The replicas match after all queued writes arrive. The last write
          to each key wins.
        </p>
        <p class="demo-hint">
          Disconnect Client B during an edit. Its writes remain local while the
          other clients continue to synchronize. When you restore the link,
          Client B receives missing writes and resubmits its offline writes.
        </p>
      </Fragment>
      <Fragment slot="outro">
        <div class="demo-outro">
        <aside class="demo-bug-teaser">
          <p>
            <strong>Last-write-wins maps can lose counter updates.</strong>
            Store a <em>counter</em> in this map and let two people increment it
            at once. One increment overwrites the other instead of adding to it.
            Use a counter structure to prevent this error.
          </p>
          <a href="/counter-bug">See the lost update →</a>
        </aside>
        <p class="demo-hint demo-outro-hint">
          Each structure has a separate page and live demo. Open the{" "}
          <a href="/structures">structure catalog</a> →
        </p>
        </div>
      </Fragment>
    </Demo>
    <DdsSections />
    <AtlasCta />
    <Architecture />
    <CodeSample />
    <Rigor />
  </main>
  <Ecosystem />
</Sheet>

<script>
  import { initReveals } from "../scripts/motion.js";
  import { initHeroDrift } from "../scripts/hero-drift.js";
  initReveals();
  initHeroDrift();
</script>

<style>
  /* Teaser callout inside the SharedMap demo intro — the LWW-is-a-trap hook
     that routes to the dedicated /counter-bug page. Magenta = attention, the
     sheet's "unverified revision" cue. */
  .demo-outro {
    max-width: 68rem;
    margin: var(--space-xl) auto 0;
  }

  .demo-outro .demo-hint {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--ink);
  }

  .demo-bug-teaser {
    margin-top: var(--space-lg);
    padding: var(--space-md) var(--space-lg);
    border: 1px solid var(--overprint);
    background: var(--surface);
    max-width: 62ch;
  }

  .demo-bug-teaser p {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--ink);
  }

  .demo-bug-teaser strong {
    color: var(--overprint-deep);
  }

  .demo-bug-teaser em {
    font-style: italic;
  }

  .demo-bug-teaser a {
    display: inline-block;
    margin-top: var(--space-xs);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--overprint-deep);
    text-decoration: none;
    border-bottom: 1px solid var(--overprint-faint);
  }

  .demo-bug-teaser a:hover {
    border-bottom-color: var(--overprint-deep);
  }
</style>
