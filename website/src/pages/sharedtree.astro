---
import { Code } from "astro:components";
import Sheet from "../layouts/Sheet.astro";
import Ecosystem from "../components/Ecosystem.astro";
import { watershedCodeTheme } from "../styles/code-theme";

// Both columns model the same document — Flowboard, the kanban board the build
// guide assembles. The Gleam side is adapted from code that compiles today
// (examples/flowboard_lustre, examples/scoreboard_cli, examples/sudoku_lustre);
// the TypeScript side uses only APIs the Fluid Framework docs publish.

const tsDeclare = `import { SchemaFactory } from "fluid-framework";

// This id is written into the document. It becomes the *stored* schema,
// and from here on the service enforces it.
const sf = new SchemaFactory("com.example.flowboard");

class Card extends sf.object("Card", {
  title: sf.string,
  column: sf.string,
  owner: sf.optional(sf.string),
}) {}

class Cards extends sf.array("Cards", Card) {}

class Board extends sf.object("Board", {
  title: sf.string,
  cards: Cards,
  wipBreaches: sf.number,
}) {}`;

const gleamDeclare = `import gleam/dynamic/decode
import gleam/json
import watershed/schema.{
  type ChannelField, type CounterChannel, type Field, type MapChannel,
}

// A phantom tag. It is erased at compile time — nothing about \`Board\`
// reaches the document, and no peer has to agree it exists.
pub type Board

pub fn title() -> Field(Board, String) {
  schema.field("title", json.string, decode.string)
}

pub fn cards() -> ChannelField(Board, MapChannel) {
  schema.channel_field("cards")
}

pub fn wip_breaches() -> ChannelField(Board, CounterChannel) {
  schema.channel_field("wip_breaches")
}`;

const tsRoot = `import { TreeViewConfiguration } from "fluid-framework";

const config = new TreeViewConfiguration({ schema: Board });
const view = tree.viewWith(config);

// Once, against an empty document. After this the stored schema is
// authoritative and every later client just reads it.
view.initialize(
  new Board({ title: "Sprint board", cards: [], wipBreaches: 0 }),
);

const board = view.root; // typed Board, guaranteed to exist`;

const gleamRoot = `fn bootstrap(doc: Document(doc_schema.Board)) -> Effect(Msg) {
  let root = watershed_js.root_typed(doc)
  effect.batch([
    // Idempotent, and run by every client on every boot. Each one
    // seeds a candidate; the handle the sequencer ordered is adopted
    // by all of them.
    watershed_lustre.ensure_field(
      root,
      doc_schema.title(),
      "Sprint board",
    ),
    watershed_lustre.ensure_map(
      doc,
      root,
      doc_schema.cards(),
      EnsuredCards,
    ),
    watershed_lustre.ensure_counter(
      doc,
      root,
      doc_schema.wip_breaches(),
      EnsuredBreaches,
    ),
  ])
}`;

const tsReadWrite = `// Writing is checked by the compiler and again by the service.
board.title = "Q3 sprint board";

// Reading is total. \`title\` is a string, and no client running this
// schema can make it anything else.
renderHeader(board.title);`;

const gleamReadWrite = `// Writing is checked at the field — only a String is accepted here.
watershed.set_field(root, doc_schema.title(), "Q3 sprint board")

// Reading decodes at the boundary. A peer running an older build — or
// a stale summary — could have written anything here, so the result is
// a \`Result\`, never a raw value.
case watershed.get_field(root, doc_schema.title()) {
  Ok(Some(title)) -> render_header(title)
  Ok(None) -> render_header("Untitled board")  // key absent
  Error(_) -> render_header("Untitled board")  // a peer wrote a number
}`;

const tsRecord = `// The shape was declared once, on the class. There is no second
// encoder to keep in sync, because the tree stores the node itself.
card.title = "Ship the gauge rebuild";
card.column = "doing";
card.owner = undefined; // clears the optional property`;

const gleamRecord = `/// \`record3\` derives the decoder AND the per-key encoder from one
/// prop list, so the two can never drift. \`sealed_known\` seals the
/// schema to exactly these keys without a hand-repeated list, and
/// \`versioned\` stamps a version and rejects an incompatible future layout.
fn card_schema() -> schema.Schema(Card, CardState) {
  schema.record3(
    CardState,
    schema.prop(card_title(), fn(c: CardState) { c.title }),
    schema.prop(card_column(), fn(c: CardState) { c.column }),
    schema.optional_prop(card_owner(), fn(c: CardState) { c.owner }),
  )
  |> schema.versioned(1)
  |> schema.sealed_known
}

// \`write\` emits one op per key, never a blob — so a peer editing
// \`owner\` at the same time keeps their edit. An optional prop that is
// \`None\` deletes its key rather than skipping it.
watershed.write(
  card,
  card_schema(),
  CardState(title: "Ship it", column: "doing", owner: None),
)`;

const tsNest = `// Everything is in one tree under one changeset algebra, so inserts,
// removals, and reorders are all edits to the same document — and all
// merge by the same rules.
board.cards.insertAtEnd(new Card({ title: "Ship it", column: "todo" }));
board.cards.moveRangeToIndex(4, 0, 3);
board.cards.removeAt(2);`;

const gleamNest = `/// One root, four merge policies — named per slot, at declaration time.
pub type SudokuDoc

pub fn cells() -> ChannelField(SudokuDoc, MapChannel) {
  schema.channel_field("cells") // last write wins, per key
}

pub fn notes() -> ChannelField(SudokuDoc, OrSetChannel) {
  schema.channel_field("notes") // add wins over a concurrent remove
}

pub fn givens() -> ChannelField(SudokuDoc, ClaimsChannel) {
  schema.channel_field("givens") // the first writer owns the slot
}

pub fn mistakes() -> ChannelField(SudokuDoc, CounterChannel) {
  schema.channel_field("mistakes") // commutative increments
}`;

const tsEvents = `// Per node, plus a subtree rollup for free: \`treeChanged\` fires for a
// change anywhere below the node, because there is a tree to roll up.
const stopCards = Tree.on(board.cards, "nodeChanged", renderCards);
const stopAll = Tree.on(board, "treeChanged", renderEverything);

// Editing the tree from inside a change callback throws a UsageError.`;

const gleamEvents = `// Per field. The change carries the decoded previous value AND the
// new one, plus whether this client made it — and a peer's
// type-confused write surfaces here as \`Error(Invalid(_))\`.
let changes = watershed.subscribe_field(root, doc_schema.title())

case process.receive(from: changes, within: 5000) {
  Ok(FieldChange(value: Ok(Some(title)), local: False, ..)) ->
    render_header(title)
  Ok(FieldChange(value: Error(_), ..)) -> keep_previous_header()
  _ -> Nil
}`;

const gleamPerKind = `// Or subscribe per channel. Each handler sees only its own channel's
// event type — a counter subscriber never pattern-matches a map event.
effect.batch([
  watershed_lustre.subscribe(shared.cells, fn(_event) { SharedChanged }),
  watershed_lustre.subscribe_or_set(shared.notes, fn(_event) { SharedChanged }),
  watershed_lustre.subscribe_claims(shared.givens, fn(_event) { SharedChanged }),
  watershed_lustre.subscribe_counter(shared.mistakes, fn(_event) {
    SharedChanged
  }),
])`;

const tsGaps = `// Atomicity — every edit in the callback lands, or none of them does.
Tree.runTransaction(board, () => {
  card.column = "doing";
  card.owner = "ada";
  if (overWipLimit(board)) return Tree.runTransaction.rollback;
});

// Undo — each local commit offers a revertible.
view.events.on("commitApplied", (data, getRevertible) => {
  if (getRevertible !== undefined) undoStack.push(getRevertible());
});

// Schema upgrade — an old document can be moved onto the new stored schema.
if (!view.compatibility.canView && view.compatibility.canUpgrade) {
  view.upgradeSchema();
}`;

const rows = [
  {
    axis: "Schema location",
    tree: "in the document, as a stored schema written on first initialize",
    ws: "in your build only, as a phantom tag and a set of field descriptors erased at runtime",
  },
  {
    axis: "A peer writes the wrong type",
    tree: "cannot happen under the stored schema; the service rejects the write",
    ws: "reaches the document, and surfaces as Error(Invalid(_)) on your read",
  },
  {
    axis: "Shape of the data",
    tree: "one tree, one changeset algebra over the whole document",
    ws: "a graph of independently addressed channels, joined by handles stored as map values",
  },
  {
    axis: "Merge policy",
    tree: "one, applied to everything in the tree",
    ws: "one per slot: LWW map, add-wins OR-set, first-writer-wins claims, commutative counter, OT rich text",
  },
  {
    axis: "Declare once",
    tree: "SchemaFactory classes; static types derived",
    ws: "Field / ChannelField / recordN; encoder and decoder derived from one prop list",
  },
  {
    axis: "Guaranteed roots",
    tree: "viewWith + initialize, once, against an empty document",
    ws: "ensure_* per slot, idempotent, run by every client on every boot",
  },
  {
    axis: "Invalidation",
    tree: "nodeChanged plus a treeChanged subtree rollup",
    ws: "subscribe_field (decoded previous and new) and narrowed per-kind channel events; no rollup above a channel",
  },
  {
    axis: "Atomic multi-field write",
    tree: "Tree.runTransaction, with rollback and preconditions",
    ws: "none: per-key ops, so peers can observe a partial record",
  },
  {
    axis: "Undo / redo",
    tree: "commitApplied → Revertible.revert()",
    ws: "none offered",
  },
  {
    axis: "Schema upgrade",
    tree: "canView / canUpgrade / upgradeSchema, plus staged rollout",
    ws: "versioned(n) fails closed with SchemaMismatch; no migration path",
  },
  {
    axis: "Moves",
    tree: "moveRangeToIndex, including between arrays in the same tree",
    ws: "convergent move inside one SharedSequence; no cross-parent move",
  },
  {
    axis: "Runs on",
    tree: "TypeScript and JavaScript",
    ws: "one Gleam core, on the BEAM and in the browser",
  },
  {
    axis: "Implementation size",
    tree: "77,804 lines in the Fluid tree package",
    ws: "686 lines in watershed/schema.gleam",
  },
];
---

<Sheet
  title="watershed: SharedTree and the schema layer"
  description="Compare Fluid Framework SharedTree with the watershed typed schema layer. The page shows six TypeScript and Gleam examples and lists the features that each model provides."
>
  <header class="st-hero">
    <div class="st-hero-inner">
      <p class="eyebrow annot">
        <a href="/">← watershed</a> · <a href="/models">Models</a> / SharedTree
      </p>
      <h1>Two schema<br /><em>enforcement models.</em></h1>
      <p class="lede">
        Fluid Framework’s <code>SharedTree</code> and watershed’s typed layer
        both declare a document shape, provide static types, establish required
        roots, and report changes. SharedTree stores and enforces the schema in
        the document. watershed keeps the schema in the application as a decode
        boundary.
      </p>
    </div>
  </header>

  <main class="doc-body">
    <div class="g-block">
      <h2>Schema location determines behavior</h2>
      <p>
        SharedTree stores the schema in the document. It writes the selected
        <code>SchemaFactory</code> ID into the container as the
        <strong>stored schema</strong>. The service then enforces it. A client
        with a different view schema cannot write an incompatible shape. One
        tree and one rebasable changeset algebra support transactions, undo and
        redo, node identity, cross-parent moves, and schema upgrades.
      </p>
      <p>
        watershed uses the schema as a <strong>decode boundary</strong> in the
        application build. A phantom type assigns fields to a document type and
        disappears at compile time. It does not enter the wire format, so a
        Fluid Framework-compatible sequencer remains independent of content.
        The document is a graph of channels, and each channel can have a
        different merge policy. Reads return a <code>Result</code> because a
        peer can write any JSON value. watershed does not provide atomic
        multi-channel writes, undo, or schema upgrades. See the{" "}
        <a href="#gaps">feature comparison</a>.
      </p>
      <div class="g-note">
        <p>
          <strong>Both columns below model the same board.</strong> The Gleam code is
          adapted from examples that compile today:
          <code>flowboard_lustre</code>, <code>scoreboard_cli</code>,
          <code>sudoku_lustre</code>. The TypeScript uses only APIs the Fluid
          Framework documentation publishes.
        </p>
      </div>
    </div>

    <div class="g-block">
      <h2>1 · Declaring the shape</h2>
      <p>
        Both systems declare the shape once and derive types.
        <code>SchemaFactory</code> writes an ID into the document.
        <code>pub type Board</code> is a phantom tag that prevents use of a field
        with the wrong map. SharedTree stores <code>wipBreaches</code> as a
        number in the tree. watershed stores a handle to a
        <code>SharedCounter</code> with commutative increments.
      </p>
      <div class="st-pair">
        <figure class="g-code">
          <figcaption class="annot">Fluid SharedTree · TypeScript</figcaption>
          <Code code={tsDeclare} lang="typescript" theme={watershedCodeTheme} />
        </figure>
        <figure class="g-code">
          <figcaption class="annot">watershed · src/doc_schema.gleam</figcaption>
          <Code code={gleamDeclare} lang="gleam" theme={watershedCodeTheme} />
        </figure>
      </div>
    </div>

    <div class="g-block">
      <h2>2 · Establishing one root</h2>
      <p>
        <code>initialize</code> runs once against an empty document. It
        writes the stored schema and every later client reads it back.
        Each client runs idempotent <code>ensure_*</code> calls during startup.
        Two clients that open a new document can each create a candidate
        channel. After synchronization, each client reads the root key again and
        adopts the handle selected by sequencer order. The clients converge on
        one handle without electing a leader.
      </p>
      <div class="st-pair">
        <figure class="g-code">
          <figcaption class="annot">Fluid SharedTree · TypeScript</figcaption>
          <Code code={tsRoot} lang="typescript" theme={watershedCodeTheme} />
        </figure>
        <figure class="g-code">
          <figcaption class="annot">watershed · Lustre effects</figcaption>
          <Code code={gleamRoot} lang="gleam" theme={watershedCodeTheme} />
        </figure>
      </div>
      <div class="g-note">
        <p>
          <strong>Unselected candidate channels remain attached.</strong> The
          document retains a candidate channel that the root does not reference.
          watershed does not collect these orphan channels.
        </p>
      </div>
    </div>

    <div class="g-block">
      <h2>3 · Reading and writing a field</h2>
      <p>
        A stored schema guarantees that <code>board.title</code> is a
        <code>string</code>, so the read needs no error case. watershed cannot
        make this guarantee. <code>get_field</code> returns
        <code>Result(Option(a), FieldError)</code>. Handle a value with an
        unexpected type at the read boundary.
      </p>
      <div class="st-pair">
        <figure class="g-code">
          <figcaption class="annot">Fluid SharedTree · TypeScript</figcaption>
          <Code
            code={tsReadWrite}
            lang="typescript"
            theme={watershedCodeTheme}
          />
        </figure>
        <figure class="g-code">
          <figcaption class="annot">watershed · Gleam</figcaption>
          <Code
            code={gleamReadWrite}
            lang="gleam"
            theme={watershedCodeTheme}
          />
        </figure>
      </div>
      <p>
        An enforced stored schema removes this error case when each writer uses
        the same build. watershed keeps the error case because an old tab, a
        stale summary, or another application can write to the same document.
        The application handles the invalid value at this boundary. The{" "}
        <a href="/guide/schema">build guide</a> shows this handling in context.
      </p>
    </div>

    <div class="g-block">
      <h2>4 · A record spread across keys</h2>
      <p>
        SharedTree stores the node, so the class declaration defines the full
        record. watershed stores JSON per key, which normally
        means writing a decoder and an encoder and keeping them in sync by hand.
        The <code>record1</code>…<code>record9</code> builders derive both
        from one prop list instead, and <code>sealed_known</code> seals the schema
        without you repeating the key names a third time.
      </p>
      <div class="st-pair">
        <figure class="g-code">
          <figcaption class="annot">Fluid SharedTree · TypeScript</figcaption>
          <Code code={tsRecord} lang="typescript" theme={watershedCodeTheme} />
        </figure>
        <figure class="g-code">
          <figcaption class="annot">watershed · Gleam</figcaption>
          <Code code={gleamRecord} lang="gleam" theme={watershedCodeTheme} />
        </figure>
      </div>
      <div class="g-note">
        <p>
          <strong>Per-key operations preserve concurrent field edits.</strong>
          If one peer writes a record while another edits <code>owner</code>,
          the owner edit remains because each key uses a separate operation. A
          peer can also read the record during the write and see only some keys
          updated. <code>Tree.runTransaction</code> prevents partial reads.
          watershed does not provide an equivalent transaction. See the{" "}
          <a href="#gaps">feature comparison</a>.
        </p>
      </div>
    </div>

    <div class="g-block">
      <h2>5 · One tree, or a graph of channels</h2>
      <p>
        SharedTree stores all document data in one tree under one changeset
        algebra. This model supports one coherent reorder across two arrays and
        applies one merge behavior throughout the tree.
      </p>
      <p>
        A watershed document contains several structures. Each slot on the root holds a
        handle to a channel that converges on its own terms, and the field
        declaration names which terms. The Sudoku example is the clearest case:
        four slots and four conflict rules for concurrent changes.
      </p>
      <div class="st-pair">
        <figure class="g-code">
          <figcaption class="annot">Fluid SharedTree · TypeScript</figcaption>
          <Code code={tsNest} lang="typescript" theme={watershedCodeTheme} />
        </figure>
        <figure class="g-code">
          <figcaption class="annot"
            >watershed · sudoku_lustre/doc_schema.gleam</figcaption
          >
          <Code code={gleamNest} lang="gleam" theme={watershedCodeTheme} />
        </figure>
      </div>
      <p>
        watershed requires a conflict rule for each slot. Pencil marks use an{" "}
        <a href="/structures/sets#orset">OR-set</a> where a
        concurrent add beats a remove, the puzzle’s givens want{" "}
        <a href="/structures/coordination#claims">first-writer-wins claims</a>,
        the mistake tally needs a{" "}
        <a href="/structures/counters#counter">counter</a> that does not
        double-count a repeated operation. SharedTree would give all four the same
        treatment. The{" "}
        <a href="/models">DDS · CRDT · OT comparison</a> lays out what each of
        those policies costs.
      </p>
      <div class="g-note">
        <p>
          <strong>Nesting uses indirection.</strong> A nested typed map,
          <code>schema.child_field("players")</code>, stores a handle. The child
          and parent are peer channels.
          There is no cross-parent move, no operation that spans two channels,
          and a root made of child fields cannot be sealed by a record schema at
          all.
        </p>
      </div>
    </div>

    <div class="g-block">
      <h2>6 · Reporting changes</h2>
      <p>
        <code>treeChanged</code> reports changes for a complete subtree because
        the tree defines a subtree boundary. watershed has no change report
        above one channel. Applications subscribe by channel and field.
      </p>
      <p>
        A watershed field subscription decodes both values. A
        <code>FieldChange</code> carries the previous value and the new
        one, already run through the field’s decoder, plus whether this client
        made it. A peer’s type-confused write arrives as an
        <code>Error</code> in the event. The application does not treat that
        write as valid state.
      </p>
      <div class="st-pair">
        <figure class="g-code">
          <figcaption class="annot">Fluid SharedTree · TypeScript</figcaption>
          <Code code={tsEvents} lang="typescript" theme={watershedCodeTheme} />
        </figure>
        <figure class="g-code">
          <figcaption class="annot">watershed · Gleam</figcaption>
          <Code code={gleamEvents} lang="gleam" theme={watershedCodeTheme} />
        </figure>
      </div>
      <figure class="g-code">
        <figcaption class="annot"
          >watershed · sudoku_lustre, narrowed per-kind subscriptions</figcaption
        >
        <Code code={gleamPerKind} lang="gleam" theme={watershedCodeTheme} />
      </figure>
    </div>

    <div class="g-block" id="gaps">
      <h2>What SharedTree has that watershed does not</h2>
      <p>
        All three of these are consequences of the same choice. A rebasable
        changeset over one enforced tree groups edits, reverts them, and moves a
        document from one stored schema to the next. watershed has operations
        over independent channels and a client-side decoder, so watershed does
        not support these features.
      </p>
      <figure class="g-code">
        <figcaption class="annot">Fluid SharedTree · TypeScript</figcaption>
        <Code code={tsGaps} lang="typescript" theme={watershedCodeTheme} />
      </figure>
      <ul>
        <li>
          <strong>Transactions.</strong> watershed writes per-key ops, so peers
          can observe a partial record. Fixing it means a batched multi-set map
          operation and a wire-format change. watershed does not implement this
          operation.
        </li>
        <li>
          <strong>Undo and redo.</strong> watershed does not provide these
          features. The kernels use <code>rollback</code> to reject and resubmit
          unacknowledged local operations. Applications cannot use it as an undo
          stack.
        </li>
        <li>
          <strong>Schema upgrade.</strong> <code>schema.versioned(n)</code>
          stamps a version and returns an error on mismatch. watershed does not
          provide a migration path or entry-level migrations.
        </li>
        <li>
          <strong>Enforcement, node identity, cross-parent moves, branching.</strong>
          watershed omits these features. Typing remains a client decode
          boundary, and the server does not inspect content.
        </li>
      </ul>
      <p>
        Fluid Framework’s tree package includes a stored and view schema system,
        a forest, compositional changeset rebasing, undo and redo, and ID
        compression. The package contains
        <strong>77,804 lines</strong>. Reproducing those features would require
        a large implementation. watershed’s schema vocabulary is
        <code>src/watershed/schema.gleam</code>, <strong>686 lines</strong>.
      </p>
    </div>
  </main>

  <section class="st-table-section" aria-labelledby="st-table-title">
    <div class="st-table-inner">
      <h2 id="st-table-title">Side by side</h2>
      <p class="st-table-intro">
        This table compares schema storage, merge rules, events, transactions,
        and implementation size.
      </p>
      <div
        class="st-table-scroll"
        role="region"
        aria-labelledby="st-table-title"
        tabindex="0"
      >
        <table class="st-table">
          <thead>
            <tr>
              <th scope="col"><span class="visually-hidden">Property</span></th>
              <th scope="col"><span class="th-kind">SharedTree</span></th>
              <th scope="col"
                ><span class="th-kind" data-side="ws">watershed</span></th
              >
            </tr>
          </thead>
          <tbody>
            {
              rows.map((r) => (
                <tr>
                  <th scope="row">{r.axis}</th>
                  <td>{r.tree}</td>
                  <td>{r.ws}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="st-guide" aria-labelledby="st-guide-title">
    <div class="st-guide-inner">
      <h2 id="st-guide-title">Further reading</h2>
      <div class="st-cta">
        <a class="cta-primary" href="/guide/schema">The schema step</a>
        <a class="cta-quiet" href="/models">DDS · CRDT · OT →</a>
        <a class="cta-quiet" href="/structures">The structure catalog →</a>
        <a
          class="cta-quiet"
          href="https://fluidframework.com/docs/data-structures/tree/"
          >SharedTree documentation ↗</a
        >
      </div>
    </div>
  </section>

  <Ecosystem />
</Sheet>

<script>
  import { initReveals } from "../scripts/motion.js";
  initReveals();
</script>

