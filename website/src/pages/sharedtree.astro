---
import Sheet from "../layouts/Sheet.astro";
import SnippetBlock from "../components/SnippetBlock.astro";
import Ecosystem from "../components/Ecosystem.astro";
import {
  standaloneSnippets,
  sharedtreeTypeScriptSnippets,
} from "../data/standalone-snippets.ts";

// Both columns model the same document: a sprint board with cards and a
// counter. The Gleam side is compiled from real sources (fixture +
// examples/sudoku_lustre); the TypeScript side uses only APIs the Fluid
// Framework docs publish.

const gleamDeclare = standaloneSnippets["sharedtree-declare"];
const gleamRoot = standaloneSnippets["sharedtree-bootstrap"];
const gleamReadWrite = standaloneSnippets["sharedtree-read-write"];
const gleamRecord = standaloneSnippets["sharedtree-record"];
const gleamNest = standaloneSnippets["sharedtree-nest"];
const gleamEvents = standaloneSnippets["sharedtree-events"];
const gleamPerKind = standaloneSnippets["sharedtree-per-kind"];

const tsDeclare = sharedtreeTypeScriptSnippets["ts-declare"];
const tsRoot = sharedtreeTypeScriptSnippets["ts-root"];
const tsReadWrite = sharedtreeTypeScriptSnippets["ts-read-write"];
const tsRecord = sharedtreeTypeScriptSnippets["ts-record"];
const tsNest = sharedtreeTypeScriptSnippets["ts-nest"];
const tsEvents = sharedtreeTypeScriptSnippets["ts-events"];
const tsGaps = sharedtreeTypeScriptSnippets["ts-gaps"];

const rows = [
  {
    axis: "Schema location",
    tree: "in the document, as a stored schema written on first initialize",
    ws: "in your build only, as a phantom tag and a set of field descriptors erased at runtime",
  },
  {
    axis: "A peer writes the wrong type",
    tree: "cannot happen under the stored schema; SharedTree rejects the write on that client",
    ws: "reaches the document, and surfaces as Error(Invalid(_)) on your read",
  },
  {
    axis: "Shape of the data",
    tree: "one tree, one changeset algebra over the whole document",
    ws: "a graph of independently addressed channels, joined by handles stored as map values",
  },
  {
    axis: "Merge policy",
    tree: "one, applied to everything in the tree",
    ws: "one per slot: LWW map, add-wins OR-set, first-writer-wins claims, commutative counter, OT rich text",
  },
  {
    axis: "Declare once",
    tree: "SchemaFactory classes; static types derived",
    ws: "Field / ChannelField / recordN; encoder and decoder derived from one prop list",
  },
  {
    axis: "Guaranteed roots",
    tree: "viewWith + initialize, once, against an empty document",
    ws: "ensure_* per slot, idempotent, run by every client on every boot",
  },
  {
    axis: "Invalidation",
    tree: "nodeChanged plus a treeChanged subtree rollup",
    ws: "subscribe_field (decoded previous and new) and narrowed per-kind channel events; no rollup above a channel",
  },
  {
    axis: "Atomic multi-field write",
    tree: "Tree.runTransaction, with rollback and preconditions",
    ws: "none: per-key ops, so peers can observe a partial record",
  },
  {
    axis: "Undo / redo",
    tree: "commitApplied → Revertible.revert()",
    ws: "none offered",
  },
  {
    axis: "Schema upgrade",
    tree: "canView / canUpgrade / upgradeSchema, plus staged rollout",
    ws: "versioned(n) fails closed with SchemaMismatch; no migration path",
  },
  {
    axis: "Moves",
    tree: "moveRangeToIndex, including between arrays in the same tree",
    ws: "convergent move inside one SharedSequence; no cross-parent move",
  },
  {
    axis: "Runs on",
    tree: "TypeScript and JavaScript",
    ws: "one Gleam core, on the BEAM and in the browser",
  },
  {
    axis: "Implementation size",
    tree: "77,804 lines in the Fluid tree package",
    ws: "about 700 lines in watershed/schema.gleam",
  },
];
---

<Sheet
  title="watershed — SharedTree and the schema layer"
  description="Fluid Framework's SharedTree puts a stored schema inside the document and enforces it in each client. watershed's typed layer puts its schema in your build, as a decode boundary over a graph of channels. Six pairs of TypeScript and Gleam, the same board both ways, and an honest list of what SharedTree has that watershed does not."
>
  <header class="st-hero">
    <div class="st-hero-inner">
      <p class="eyebrow annot">
        <a href="/">← watershed</a> · <a href="/models">Models</a> / SharedTree
      </p>
      <h1>Two places to put<br /><em>the guarantee.</em></h1>
      <p class="lede">
        Fluid Framework's <code>SharedTree</code> and watershed's typed layer
        want the same thing: declare a document's shape once, get static types,
        get roots that are guaranteed to be there, get told when something
        changes. They disagree about where to put the guarantee, and almost
        everything else follows from that choice.
      </p>
    </div>
  </header>

  <main class="doc-body">
    <div class="g-block">
      <h2>The one difference the rest follows from</h2>
      <p>
        SharedTree makes the schema <em>the document</em>. The
        <code>SchemaFactory</code> id you pick is written into the container as
        the <strong>stored schema</strong>, and from then on every client's
        SharedTree enforces it. A client whose view schema disagrees cannot
        silently write the wrong shape. Because there is one tree under one rebasable
        changeset algebra, transactions, undo/redo, node identity, cross-parent
        moves, and a real schema-upgrade path all fall out of the same
        machinery.
      </p>
      <p>
        watershed makes the schema a <strong>decode boundary</strong> that
        exists only in your build. The tag scoping a set of fields is a phantom
        type, erased at compile time. Nothing about it reaches the wire, and
        any Fluid Framework-compatible sequencer (floodgate included) stays
        content-agnostic by design. In exchange the document is not one
        structure but a graph of independently converging channels, so the
        merge policy is named per slot rather than once for everything.
        Reads hand back a <code>Result</code>, because a peer really
        can write anything. What you do not get is atomicity, undo, or a
        schema upgrade. Those are listed{" "}
        <a href="#gaps">further down</a>, not buried.
      </p>
      <div class="g-note">
        <p>
          <strong>Both columns below model the same board.</strong> The Gleam
          is compiled from real source: a fixture package and
          <code>sudoku_lustre</code>. The TypeScript uses only APIs the Fluid
          Framework documentation publishes.
        </p>
      </div>
    </div>

    <div class="g-block">
      <h2>1 · Declaring the shape</h2>
      <p>
        Both declare once and derive the types. The difference is what the
        declaration <em>is</em>: a <code>SchemaFactory</code> id becomes part of
        the document, where <code>pub type Board</code> is a phantom tag that
        exists only to stop you reading a field against the wrong map. Note the
        counter too: SharedTree's <code>wipBreaches</code> is a number in the
        tree; watershed's is a handle to a whole <code>SharedCounter</code>,
        with commutative increments of its own. <a href="/foundations/schema"
          >Foundations · schemas and fields</a
        > covers that phantom tag, and the three kinds of field, in full.
      </p>
      <div class="st-pair">
        <div class="st-col">
          <SnippetBlock snippet={tsDeclare}>
            <figcaption slot="caption" class="annot"
              >Fluid SharedTree · TypeScript</figcaption
            >
          </SnippetBlock>
        </div>
        <div class="st-col">
          <SnippetBlock snippet={gleamDeclare}>
            <figcaption slot="caption" class="annot"
              >watershed · Gleam</figcaption
            >
          </SnippetBlock>
        </div>
      </div>
    </div>

    <div class="g-block">
      <h2>2 · Establishing one root</h2>
      <p>
        <code>initialize</code> is a once-only act against an empty document; it
        writes the stored schema and every later client reads it back.
        <code>ensure_*</code> is the opposite shape: idempotent, and run by
        every client on every boot. Two clients opening a fresh document both
        seed a candidate channel; each one waits for its own write to sync,
        then adopts whichever handle the field shows at that moment — a
        concurrent write from the other client can still land after and
        replace the field. The field itself converges on one handle without a
        leader; the handle each call returns just isn't promised to be that
        one. <a href="/foundations/lifecycle"
          >Foundations · starting a document</a
        > walks through that whole bootstrap in order.
      </p>
      <div class="st-pair">
        <div class="st-col">
          <SnippetBlock snippet={tsRoot}>
            <figcaption slot="caption" class="annot"
              >Fluid SharedTree · TypeScript</figcaption
            >
          </SnippetBlock>
        </div>
        <div class="st-col">
          <SnippetBlock snippet={gleamRoot}>
            <figcaption slot="caption" class="annot"
              >watershed · Gleam, in a Lustre effect</figcaption
            >
          </SnippetBlock>
        </div>
      </div>
      <div class="g-note">
        <p>
          <strong>The losers stay attached.</strong> A candidate channel that
          did not win the race is still attached to the document, just
          unreferenced. Orphan collection is out of scope; that's the cost of
          not having a leader elect the root.
        </p>
      </div>
    </div>

    <div class="g-block">
      <h2>3 · Reading and writing a field</h2>
      <p>
        This pair is the whole argument, and it is short.
        <code>board.title</code> is a
        <code>string</code>, and under a stored schema it cannot be anything
        else, so the read needs no error arm. watershed cannot promise that, so
        it does not pretend to: <code>get_field</code> returns
        <code>Result(Option(a), FieldError)</code>, and you confront the “a peer
        disagrees about this type” case once, at the read, instead of
        discovering it later as corrupted state.
      </p>
      <div class="st-pair">
        <div class="st-col">
          <SnippetBlock snippet={tsReadWrite}>
            <figcaption slot="caption" class="annot"
              >Fluid SharedTree · TypeScript</figcaption
            >
          </SnippetBlock>
        </div>
        <div class="st-col">
          <SnippetBlock snippet={gleamReadWrite}>
            <figcaption slot="caption" class="annot"
              >watershed · Gleam</figcaption
            >
          </SnippetBlock>
        </div>
      </div>
      <p>
        Whether that <code>Error</code> arm is a tax or a feature depends on
        what you can assume about the clients. If every writer runs your build
        against an enforced stored schema, it is noise. If an old tab, a stale
        summary, or a second application can reach the same document, it is the
        one place a multiplayer app gets to decide what to do about
        disagreement. The <a href="/guide/notes">build guide</a> works through
        it in context.
      </p>
    </div>

    <div class="g-block">
      <h2>4 · A record spread across keys</h2>
      <p>
        SharedTree stores the node, so the class declaration is the only
        declaration there is. watershed stores JSON per key, which normally
        means writing a decoder and an encoder and keeping them in sync by hand.
        The <code>record1</code>…<code>record9</code> builders derive both
        from one prop list instead, and <code>sealed_known</code> seals the schema
        without you repeating the key names a third time.
      </p>
      <div class="st-pair">
        <div class="st-col">
          <SnippetBlock snippet={tsRecord}>
            <figcaption slot="caption" class="annot"
              >Fluid SharedTree · TypeScript</figcaption
            >
          </SnippetBlock>
        </div>
        <div class="st-col">
          <SnippetBlock snippet={gleamRecord}>
            <figcaption slot="caption" class="annot"
              >watershed · Gleam</figcaption
            >
          </SnippetBlock>
        </div>
      </div>
      <div class="g-note">
        <p>
          <strong>Per-key ops cut both ways.</strong> Writing a whole record as
          one op per key is why a peer editing <code>owner</code> at the same
          moment keeps their edit: the record view is never a clobbering blob.
          It is also why a peer can read the record <em>mid-write</em> and see
          three of four keys updated. <code>Tree.runTransaction</code> would
          prevent that; watershed has no answer for it yet. See{" "}
          <a href="#gaps">below</a>.
        </p>
      </div>
    </div>

    <div class="g-block">
      <h2>5 · One tree, or a graph of channels</h2>
      <p>
        Here the two models stop resembling each other. Everything in a
        SharedTree is in the tree, under one changeset algebra. That is what
        makes a reorder across two arrays a coherent operation, and what makes
        the merge behaviour uniform enough that you never have to think about
        it.
      </p>
      <p>
        A watershed document is not one structure. Each slot on the root holds a
        handle to a channel that converges on its own terms, and the field
        declaration names which terms. The Sudoku example is the clearest case:
        four slots, four different answers to “what happens when two clients
        touch this at once”. <a href="/foundations/topology"
          >Foundations · documents and handles</a
        > lays out that layout on its own terms, without the SharedTree
        comparison.
      </p>
      <div class="st-pair">
        <div class="st-col">
          <SnippetBlock snippet={tsNest}>
            <figcaption slot="caption" class="annot"
              >Fluid SharedTree · TypeScript</figcaption
            >
          </SnippetBlock>
        </div>
        <div class="st-col">
          <SnippetBlock snippet={gleamNest}>
            <figcaption slot="caption" class="annot"
              >watershed · Gleam</figcaption
            >
          </SnippetBlock>
        </div>
      </div>
      <p>
        So watershed makes you choose, and in exchange lets you choose right:
        pencil marks want an <a href="/structures/sets#orset">OR-set</a> where a
        concurrent add beats a remove, the puzzle's givens want{" "}
        <a href="/structures/coordination#claims">first-writer-wins claims</a>,
        the mistake tally wants a{" "}
        <a href="/structures/counters#counter">counter</a> that does not
        double-count a redelivered op. SharedTree would give all four the same
        treatment. The{" "}
        <a href="/models">DDS · CRDT · OT comparison</a> lays out what each of
        those policies costs.
      </p>
      <div class="g-note">
        <p>
          <strong>Nesting is indirection, not containment.</strong> A nested
          typed map, <code>schema.child_field("players")</code>, stores a
          handle, and the child is a peer channel, not a subtree of its parent.
          There is no cross-parent move, no operation that spans two channels,
          and a root made of child fields cannot be sealed by a record schema at
          all. See <a href="/foundations/topology">Foundations · documents and
          handles</a> for what that costs you in practice.
        </p>
      </div>
    </div>

    <div class="g-block">
      <h2>6 · Being told what changed</h2>
      <p>
        <code>treeChanged</code> is the thing a tree buys you that a graph
        cannot: a rollup over an entire subtree, for free, because the subtree
        is a real thing with a boundary. watershed has no rollup above a single
        channel: you subscribe per channel, and per field.
      </p>
      <p>
        What a field subscription gives back in exchange is decoded on both
        sides. A <code>FieldChange</code> carries the previous value and the new
        one, already run through the field's decoder, plus whether this client
        made it. A peer's type-confused write arrives as an
        <code>Error</code> in the event rather than as state that looks fine
        until it does not.
      </p>
      <div class="st-pair">
        <div class="st-col">
          <SnippetBlock snippet={tsEvents}>
            <figcaption slot="caption" class="annot"
              >Fluid SharedTree · TypeScript</figcaption
            >
          </SnippetBlock>
        </div>
        <div class="st-col">
          <SnippetBlock snippet={gleamEvents}>
            <figcaption slot="caption" class="annot"
              >watershed · Gleam</figcaption
            >
          </SnippetBlock>
        </div>
      </div>
      <div class="st-solo">
        <SnippetBlock snippet={gleamPerKind}>
          <figcaption slot="caption" class="annot"
            >watershed · Gleam, narrowed per-kind subscriptions</figcaption
          >
        </SnippetBlock>
      </div>
    </div>

    <div class="g-block" id="gaps">
      <h2>What SharedTree has that watershed does not</h2>
      <p>
        All three of these are consequences of the same choice. A rebasable
        changeset over one enforced tree is what lets you group edits, revert
        them, and move a document from one stored schema to the next. watershed
        has ops over independent channels and a client-side decoder, so it has
        none of them.
      </p>
      <div class="st-solo">
        <SnippetBlock snippet={tsGaps}>
          <figcaption slot="caption" class="annot"
            >Fluid SharedTree · TypeScript</figcaption
          >
        </SnippetBlock>
      </div>
      <ul>
        <li>
          <strong>Transactions.</strong> watershed writes per-key ops, so peers
          can observe a partial record. Fixing it means a batched multi-set map
          op: a wire-format change, deliberately deferred until a real consumer
          hurts.
        </li>
        <li>
          <strong>Undo and redo.</strong> Not offered. The kernels do have a
          <code>rollback</code>, but that is nack-and-resubmit machinery for
          unacknowledged local ops, not a user-facing stack.
        </li>
        <li>
          <strong>Schema upgrade.</strong> <code>schema.versioned(n)</code>
          stamps a version and fails closed on mismatch, which is a dead end
          rather than a path. Entries-level migrations are designed and
          unshipped.
        </li>
        <li>
          <strong>Enforcement, node identity, cross-parent moves, branching.</strong>
          Absent by design. Typing stays a client decode boundary; the server
          stays content-agnostic.
        </li>
      </ul>
      <p>
        The reason is worth stating as a number rather than an adjective. Fluid
        Framework's tree package (stored-versus-view schema system, forest,
        compositional changeset rebasing, undo/redo, ID compression) is
        <strong>77,804 lines</strong> — a multi-year project to reproduce in
        any language, and one watershed would take on only for a compelling
        product need. watershed's entire schema vocabulary is
        one <strong>roughly 700-line</strong> module:
        <code>src/watershed/schema.gleam</code>. That is the trade.
      </p>
    </div>
  </main>

  <section class="st-table-section" aria-labelledby="st-table-title">
    <div class="st-table-inner">
      <h2 id="st-table-title">Side by side</h2>
      <p class="st-table-intro">
        The same axes, two answers. Read the bottom four rows together with the
        top one: they are the same decision, seen from either end.
      </p>
      <div
        class="st-table-scroll"
        role="region"
        aria-labelledby="st-table-title"
        tabindex="0"
      >
        <table class="st-table">
          <thead>
            <tr>
              <th scope="col"><span class="visually-hidden">Property</span></th>
              <th scope="col"><span class="th-kind">SharedTree</span></th>
              <th scope="col"
                ><span class="th-kind" data-side="ws">watershed</span></th
              >
            </tr>
          </thead>
          <tbody>
            {
              rows.map((r) => (
                <tr>
                  <th scope="row">{r.axis}</th>
                  <td>{r.tree}</td>
                  <td>{r.ws}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="st-guide" aria-labelledby="st-guide-title">
    <div class="st-guide-inner">
      <h2 id="st-guide-title">Further reading</h2>
      <div class="st-cta">
        <a class="cta-primary" href="/guide/notes">The decode boundary →</a>
        <a class="cta-quiet" href="/models">DDS · CRDT · OT →</a>
        <a class="cta-quiet" href="/structures">The field atlas →</a>
        <a
          class="cta-quiet"
          href="https://fluidframework.com/docs/data-structures/tree/"
          >SharedTree documentation ↗</a
        >
      </div>
    </div>
  </section>

  <Ecosystem />
</Sheet>

<script>
  import { initReveals } from "../scripts/motion.js";
  initReveals();
</script>

<style>
  /* ── hero ───────────────────────────────────────────────────────────────── */
  .st-hero {
    padding: clamp(3.5rem, 9vw, 7rem) var(--content-pad) clamp(2.5rem, 6vw, 5rem);
    border-bottom: 1px solid var(--hairline);
  }

  .st-hero-inner {
    max-width: 68rem;
    margin-inline: auto;
  }

  .eyebrow {
    color: var(--muted);
    margin: 0 0 var(--space-lg);
  }

  .eyebrow a {
    color: var(--waterline);
    text-decoration: none;
  }

  .eyebrow a:hover {
    color: var(--overprint-deep);
  }

  h1 {
    font-size: var(--text-display);
    font-weight: 640;
    font-stretch: 122%;
    line-height: 0.99;
    letter-spacing: -0.025em;
  }

  h1 em {
    font-style: normal;
    color: var(--overprint-deep);
  }

  /* Narrow screens: the 122% width expansion overflows the sheet frame. */
  @media (max-width: 30rem) {
    h1 {
      font-size: clamp(1.9rem, 8.5vw, 2.7rem);
      font-stretch: 100%;
      letter-spacing: -0.03em;
    }
  }

  .lede {
    margin-top: var(--space-xl);
    font-size: clamp(1.125rem, 0.6vw + 1rem, 1.3125rem);
    line-height: 1.6;
    max-width: 58ch;
  }

  .lede code {
    font-size: 0.85em;
    color: var(--overprint-deep);
  }

  /* ── the code pair ──────────────────────────────────────────────────────
     The one piece of layout this sheet adds. `minmax(0, 1fr)` rather than
     `1fr` is required: a grid track defaults to min-content width, so a
     long code line would push the column — and the page — wider than the
     viewport instead of scrolling inside its own figure. */
  .st-pair {
    margin-top: var(--space-lg);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-lg);
    align-items: start;
  }

  /* One column is one SnippetBlock, which renders two siblings — the source
     chip and the figure. They are wrapped so the grid sees one item per side
     rather than four items in two rows. */
  .st-col {
    min-width: 0;
  }

  /* Two columns of code do not fit the 68rem reading measure — at that width
     every pair scrolls sideways to be read, which defeats the comparison. So
     the pairs alone break out of the column, symmetrically, once the viewport
     can spare it. The negative margin is derived from the parent's own content
     width, so it stays centred whatever --content-pad clamps to. */
  @media (min-width: 82rem) {
    .st-pair {
      width: 78rem;
      margin-inline: calc((100% - 78rem) / 2);
    }
  }

  /* Set against the widened column this lands ~75 characters per line, which
     is what the snippets are hand-wrapped to. The figure comes from
     SnippetBlock and carries that component's scope, so a parent reaches it
     with `:global()`. */
  .st-pair :global(.g-code pre) {
    font-size: 0.765rem;
  }

  /* The source chip leads each block. In a pair it sits directly above the
     column label, so it loses the reading-column spacing it gets elsewhere. */
  .st-pair :global(.g-file),
  .st-solo :global(.g-file) {
    margin: 0 0 var(--space-sm);
  }

  /* The shared .g-code caption sits below its block; in a pair it has to lead,
     because you need to know which side you are reading before you read it. */
  .st-pair :global(.g-code) {
    margin-top: 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .st-pair :global(.g-code figcaption),
  .st-solo :global(.g-code figcaption) {
    order: -1;
    margin: 0 0 var(--space-sm);
    text-align: left;
  }

  .st-solo :global(.g-code) {
    margin-top: 0;
    display: flex;
    flex-direction: column;
  }

  .st-solo {
    margin-top: var(--space-lg);
  }

  @media (max-width: 860px) {
    .st-pair {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ── scorecard ──────────────────────────────────────────────────────────── */
  .st-table-section {
    padding: var(--space-2xl) var(--content-pad);
    margin-top: var(--space-2xl);
    border-top: 1px solid var(--hairline);
  }

  .st-table-inner {
    max-width: 68rem;
    margin-inline: auto;
  }

  .st-table-section h2 {
    font-size: var(--text-h2);
    font-weight: 620;
    font-stretch: 118%;
    letter-spacing: -0.015em;
    line-height: 1.05;
  }

  .st-table-intro {
    margin-top: var(--space-md);
    color: var(--muted);
    max-width: 58ch;
  }

  .st-table-scroll {
    margin-top: var(--space-xl);
    overflow-x: auto;
    border: 1px solid var(--ink);
  }

  .st-table-scroll:focus-visible {
    outline: 2px solid var(--overprint);
    outline-offset: 2px;
  }

  .st-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 44rem;
    background: var(--bg);
  }

  .st-table th,
  .st-table td {
    text-align: left;
