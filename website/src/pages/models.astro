---
import Sheet from "../layouts/Sheet.astro";
import Ecosystem from "../components/Ecosystem.astro";
import { categories } from "../data/structures";

const dds = categories
  .flatMap((c) => c.structures.map((s) => ({ ...s, slug: c.slug })))
  .filter((s) => s.kind === "DDS");
const crdt = categories
  .flatMap((c) => c.structures.map((s) => ({ ...s, slug: c.slug })))
  .filter((s) => s.kind === "CRDT");
const ot = categories
  .flatMap((c) => c.structures.map((s) => ({ ...s, slug: c.slug })))
  .filter((s) => s.kind === "OT");

const models = [
  {
    kind: "DDS",
    name: "Distributed Data Structure",
    gloss: "Uses one server to order all operations.",
    body: [
      "A DDS in watershed follows Fluid Framework’s collaborative-object model. Each client applies local operations before confirmation and sends them to a central sequencer. The server returns one authoritative order. Each replica applies the same ordered stream and reaches the same state.",
      "A conflict policy interprets that order. A map uses last-write-wins, a claim uses first-writer-wins, a queue uses FIFO, and a pact uses a quorum. Server order remains authoritative.",
    ],
    tradeoff:
      "A DDS stores little merge metadata and requires a sequencer. Its conflict policy determines offline safety.",
    members: dds.map((s) => ({ name: s.name, href: `/structures/${s.slug}#${s.id}` })),
  },
  {
    kind: "CRDT",
    name: "Conflict-free Replicated Data Type",
    gloss: "Uses a merge function and does not require operation order.",
    body: [
      "A CRDT has a commutative, associative, and idempotent merge. Two replicas converge after they receive the same updates, in any order and with any number of repetitions. A CRDT does not require a central authority.",
      "watershed can deliver CRDT operations over a sequenced stream. CRDT correctness does not depend on that order. A repeated delta does not change the result. An order-based DDS depends on runtime deduplication by sequence number.",
    ],
    tradeoff:
      "A CRDT merge accepts duplicate and reordered state or deltas. Offline editing still needs durable local storage and a reconnect protocol. Metadata costs depend on the type: some keep per-replica counters, while removable collections retain tags or tombstones.",
    members: crdt.map((s) => ({ name: s.name, href: `/structures/${s.slug}#${s.id}` })),
  },
  {
    kind: "OT",
    name: "Operational Transform",
    gloss: "Transforms concurrent operations against one another.",
    body: [
      "OT transforms each operation against concurrent operations that it did not observe. The transform changes indices and positions so that each client calculates the same result.",
      "watershed has two OT kernels that use a one-operation-in-flight protocol. json_ot ports the ottypes json0 algebra for JSON documents. SharedRichText applies the protocol to the quill-delta rich-text algebra. Both transform the positions of concurrent operations.",
    ],
    tradeoff:
      "OT uses little metadata for each operation and suits ordered sequences and rich text. Each pair of operation types requires a correct transform function.",
    members: ot.map((s) => ({
      name: s.name,
      href: s.demoHref ?? `/structures/${s.slug}#${s.id}`,
    })),
  },
];

const rows = [
  {
    axis: "Converges via",
    dds: "one server’s total order",
    crdt: "a commutative merge function",
    ot: "pairwise operation transforms",
  },
  {
    axis: "Needs a sequencer",
    dds: "Yes. Server order determines the result.",
    crdt: "No. watershed can still use a sequencer for transport.",
    ot: "Yes: to assign the order to transform against",
  },
  {
    axis: "Duplicate and reordered delivery",
    dds: "runtime orders and deduplicates by sequence number",
    crdt: "merge accepts repeats and reordering",
    ot: "client protocol buffers and transforms the ordered stream",
  },
  {
    axis: "Per-item metadata",
    dds: "structure-dependent; often a value plus sequence data",
    crdt: "type-dependent; may include replica slots, tags, or tombstones",
    ot: "document state plus in-flight and buffered operations",
  },
  {
    axis: "Offline and unreliable links",
    dds: "policy and client persistence determine safety",
    crdt: "merge supports offline and unordered delivery; durable storage is still required",
    ot: "requires buffered operations and ordered reconnect",
  },
  {
    axis: "Best fit",
    dds: "central authority and coordination",
    crdt: "offline editing and at-least-once delivery",
    ot: "text and ordered sequences",
  },
];
---

<Sheet
  title="watershed: DDS vs CRDT vs OT"
  description="Compare three convergence models: distributed data structures, conflict-free replicated data types, and operational transform. Learn which watershed structures use each model."
>
  <header class="mod-hero">
    <div class="mod-hero-inner">
      <p class="eyebrow annot">
        <a href="/">← watershed</a> · <a href="/structures">Data structures</a> /
        Convergence models
      </p>
      <h1>Three ways to<br /><em>agree on state.</em></h1>
      <p class="lede">
        Each structure must resolve concurrent changes. watershed supports
        three methods: order operations, merge updates, or transform operations.
        Select the method that matches your data and delivery requirements.
      </p>
    </div>
  </header>

  <main>
    <section class="mod-cards" aria-label="Convergence models">
      {
        models.map((m) => (
          <article class="mod-card" data-reveal="rise">
            <header class="mod-card-head">
              <span class="stamp" data-kind={m.kind}>
                {m.kind}
              </span>
              <h2>{m.name}</h2>
              <p class="mod-gloss">{m.gloss}</p>
            </header>
            <div class="mod-card-body">
              {m.body.map((para) => (
                <p>{para}</p>
              ))}
              <p class="mod-tradeoff">{m.tradeoff}</p>
            </div>
            <footer class="mod-members">
              <span class="annot">In watershed</span>
              <ul>
                {m.members.map((mem) => (
                  <li>
                    <a href={mem.href}>
                      <code>{mem.name}</code>
                    </a>
                  </li>
                ))}
              </ul>
            </footer>
          </article>
        ))
      }
    </section>

    <section class="mod-table-section" aria-labelledby="mod-table-title">
      <h2 id="mod-table-title">Side by side</h2>
      <p class="mod-table-intro">
        Each model has different requirements for sequencing, metadata, and
        offline operation.
      </p>
      <div class="mod-table-scroll" role="region" aria-labelledby="mod-table-title" tabindex="0">
        <table class="mod-table">
          <thead>
            <tr>
              <th scope="col"><span class="visually-hidden">Property</span></th>
              <th scope="col"><span class="th-kind" data-kind="DDS">DDS</span></th>
              <th scope="col"><span class="th-kind" data-kind="CRDT">CRDT</span></th>
              <th scope="col"><span class="th-kind" data-kind="OT">OT</span></th>
            </tr>
          </thead>
          <tbody>
            {
              rows.map((r) => (
                <tr>
                  <th scope="row">{r.axis}</th>
                  <td>{r.dds}</td>
                  <td>{r.crdt}</td>
                  <td>{r.ot}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section class="mod-guide" aria-labelledby="mod-guide-title">
      <div class="mod-guide-inner">
        <h2 id="mod-guide-title">Which model fits?</h2>
        <ol class="mod-guide-list">
          <li>
            <strong>Use a DDS with a central sequencer.</strong> Use this model
            when last-write-wins or explicit coordination is acceptable. Choose{" "}
            <a href="/structures/maps#map">SharedMap</a>,
            {" "}
            <a href="/structures/coordination#claims">Claims</a>, or
            {" "}
            <a href="/structures/coordination#pact">PactMap</a>.
          </li>
          <li>
            <strong>Use a CRDT when delivery is unreliable.</strong> Offline
            edits backed by durable local storage, at-least-once delivery, or a
            counter that must accept a repeated delta require a merge that
            produces the same result in any order:{" "}
            <a href="/structures/counters#pn">PN counter</a>,
            {" "}
            <a href="/structures/sets#orset">OR-set</a>, or
            {" "}
            <a href="/structures/maps#ormap">OR-map</a>.
          </li>
          <li>
            <strong>Use OT for ordered sequences and rich text.</strong>
            OT adjusts positions when concurrent edits change collaborative
            text or lists. See the{" "}
            <a href="/json-ot">json_ot demo</a> for structured JSON or the
            {" "}
            <a href="/rich-text">SharedRichText demo</a> for a
            three-editor Quill session.
          </li>
        </ol>
        <div class="mod-cta">
          <a class="cta-primary" href="/structures">Back to the field guide</a>
          <a class="cta-quiet" href="/runtime">How the runtime behaves →</a>
          <a class="cta-quiet" href="/sharedtree">Fluid’s SharedTree, compared →</a>
          <a class="cta-quiet" href="/#demo">Compare live merge policies ↓</a>
        </div>
      </div>
    </section>
  </main>

  <Ecosystem />
</Sheet>

<script>
  import { initReveals } from "../scripts/motion.js";
  initReveals();
</script>

<style>
  .mod-hero {
    padding: clamp(3.5rem, 9vw, 7rem) var(--content-pad) clamp(2.5rem, 6vw, 5rem);
    border-bottom: 1px solid var(--hairline);
  }

  .mod-hero-inner {
    max-width: 68rem;
    margin-inline: auto;
  }

  .eyebrow {
    color: var(--muted);
    margin: 0 0 var(--space-lg);
  }

  .eyebrow a {
    color: var(--waterline);
    text-decoration: none;
  }

  .eyebrow a:hover {
    color: var(--overprint-deep);
  }

  h1 {
    font-size: var(--text-display);
    font-weight: 640;
    font-stretch: 122%;
    line-height: 0.99;
    letter-spacing: -0.025em;
  }

  h1 em {
    font-style: normal;
    color: var(--overprint-deep);
  }

  /* Narrow screens: the 122% width expansion overflows the sheet frame; relax
     it to normal width and tighten the size floor (matches the hero). */
  @media (max-width: 30rem) {
    h1 {
      font-size: clamp(1.9rem, 8.5vw, 2.7rem);
      font-stretch: 100%;
      letter-spacing: -0.03em;
    }
  }

  .lede {
    margin-top: var(--space-xl);
    font-size: clamp(1.125rem, 0.6vw + 1rem, 1.3125rem);
    line-height: 1.6;
    max-width: 58ch;
  }

  h2 {
    font-size: var(--text-h2);
    font-weight: 620;
    font-stretch: 118%;
    letter-spacing: -0.015em;
    line-height: 1.05;
  }

  /* ── model cards ──────────────────────────────────────────────────────── */
  .mod-cards {
    max-width: 72rem;
    margin-inline: auto;
    padding: var(--space-2xl) var(--content-pad);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(19rem, 100%), 1fr));
    gap: var(--space-lg);
  }

  .mod-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--ink);
    background: var(--bg);
    padding: var(--space-xl);
  }

  .mod-card-head {
    border-bottom: 1px solid var(--hairline);
    padding-bottom: var(--space-md);
  }

  .stamp {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.18rem 0.5rem;
    border: 1.5px solid currentColor;
    color: var(--muted);
    transform: rotate(-2deg);
  }

  .stamp[data-kind="DDS"] {
    color: var(--ink);
  }

  .stamp[data-kind="CRDT"] {
    color: var(--waterline);
  }

  .stamp[data-kind="OT"] {
    color: var(--overprint-deep);
  }

  .mod-card-head h2 {
    margin-top: var(--space-sm);
    font-size: 1.5rem;
    font-stretch: 114%;
    line-height: 1.1;
  }

  .mod-gloss {
    margin-top: var(--space-xs);
    color: var(--overprint-deep);
    font-size: var(--text-sm);
  }

  .mod-card-body {
    margin-top: var(--space-md);
    flex: 1;
  }

  .mod-card-body p {
    color: var(--ink);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .mod-card-body p + p {
    margin-top: var(--space-sm);
  }

  .mod-tradeoff {
    margin-top: var(--space-md);
    padding-top: var(--space-md);
    border-top: 1px dashed var(--hairline);
    color: var(--muted) !important;
  }

  .mod-members {
    margin-top: var(--space-lg);
    padding-top: var(--space-md);
    border-top: 1px solid var(--hairline);
  }

  .mod-members ul {
    margin: var(--space-sm) 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-sm);
  }

  .mod-members code {
    font-size: 0.85rem;
  }

  /* ── comparison table ─────────────────────────────────────────────────── */
  .mod-table-section {
    max-width: 72rem;
    margin-inline: auto;
    padding: var(--space-2xl) var(--content-pad);
    border-top: 1px solid var(--hairline);
  }

  .mod-table-intro {
    margin-top: var(--space-md);
    color: var(--muted);
    max-width: 58ch;
  }

  .mod-table-scroll {
    margin-top: var(--space-xl);
    overflow-x: auto;
    border: 1px solid var(--ink);
  }

  .mod-table-scroll:focus-visible {
    outline: 2px solid var(--overprint);
    outline-offset: 2px;
  }

  .mod-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 40rem;
    background: var(--bg);
  }

  .mod-table th,
  .mod-table td {
    text-align: left;
    padding: var(--space-md) var(--space-lg);
    border-bottom: 1px solid var(--hairline);
    vertical-align: top;
    font-size: var(--text-sm);
  }

  .mod-table thead th {
    position: sticky;
    top: 0;
    background: var(--surface);
    border-bottom: 1px solid var(--ink);
  }

  .mod-table tbody tr:last-child th,
  .mod-table tbody tr:last-child td {
    border-bottom: 0;
  }

  .mod-table tbody th[scope="row"] {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
    background: var(--surface);
    border-right: 1px solid var(--hairline);
  }

  .th-kind {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    color: var(--ink);
  }

  .th-kind[data-kind="CRDT"] {
    color: var(--waterline);
  }

  .th-kind[data-kind="OT"] {
    color: var(--overprint-deep);
  }

  /* ── guide ────────────────────────────────────────────────────────────── */
  .mod-guide {
    border-top: 1px solid var(--hairline);
    background:
      linear-gradient(var(--hairline-faint) 1px, transparent 1px),
      linear-gradient(90deg, var(--hairline-faint) 1px, transparent 1px),
      var(--surface);
    background-size: 3.5rem 3.5rem;
    padding: var(--space-section) var(--content-pad);
  }

  .mod-guide-inner {
    max-width: 68rem;
    margin-inline: auto;
  }

  .mod-guide-list {
    margin: var(--space-xl) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-lg);
    counter-reset: guide;
  }

  .mod-guide-list li {
    position: relative;
    padding-left: 3rem;
    max-width: 64ch;
    color: var(--ink);
  }

  .mod-guide-list li::before {
    counter-increment: guide;
    content: counter(guide, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 0.1rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--overprint-deep);
  }

  .mod-guide-list strong {
    font-stretch: 110%;
  }

  .mod-cta {
    margin-top: var(--space-2xl);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-lg);
  }

  .cta-primary {
    display: inline-block;
    padding: 0.8rem 1.6rem;
    background: var(--overprint);
    color: oklch(100% 0 0);
    text-decoration: none;
    font-weight: 600;
    font-stretch: 110%;
    transition: background var(--dur-feedback) var(--ease-out-quart);
  }

  .cta-primary:hover {
    background: var(--overprint-deep);
    color: oklch(100% 0 0);
  }

  .cta-quiet {
    font-weight: 500;
    color: var(--waterline);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
