---
import { Code } from "astro:components";
import GuideLayout from "../../components/GuideLayout.astro";
import { watershedCodeTheme } from "../../styles/code-theme";
import appSource from "../../../../examples/flowboard_lustre/src/flowboard_lustre.gleam?raw";
import buildScript from "../../../../examples/flowboard_lustre/build.mjs?raw";
import schemaSource from "../../../../examples/flowboard_lustre/src/doc_schema.gleam?raw";
import gleamToml from "../../../../examples/flowboard_lustre/gleam.toml?raw";
import packageJson from "../../../../examples/flowboard_lustre/package.json?raw";
import pnpmWorkspace from "../../../../examples/flowboard_lustre/pnpm-workspace.yaml?raw";
import indexHtml from "../../../../examples/flowboard_lustre/index.html?raw";

const connect = `import lustre/effect.{type Effect}
import watershed_lustre

// connect_dev mints a dev token in the browser, then connects. In production,
// issue the token from a backend and use watershed_lustre.connect instead.
fn connect_effect(model: Model) -> Effect(Msg) {
  watershed_lustre.connect_dev(
    url: "ws://127.0.0.1:4000/socket/websocket?vsn=2.0.0",
    tenant: "flow-co",
    secret: dev_secret,
    document: "flowboard",
    user_id: model.user_id,
    got_document: GotDocument,   // dispatched with the Document handle
    connected: Connected,        // dispatched with Ok(Nil) once synced
  )
}`;

const bootstrap = `import doc_schema
import watershed_js
import watershed_lustre

// The same ensure_* from step 02, now as a batch of effects. Each channel
// ensure dispatches its handle back so update can store it in the model.
fn bootstrap_effect(doc: Document(doc_schema.Board)) -> Effect(Msg) {
  let root = watershed_js.root_typed(doc)
  effect.batch([
    watershed_lustre.ensure_field(root, doc_schema.title(), "Untitled board"),
    watershed_lustre.ensure_map(doc, root, doc_schema.cards(), EnsuredCards),
    watershed_lustre.ensure_counter(doc, root, doc_schema.wip_breaches(), EnsuredBreaches),
  ])
}`;

const update = `fn update(model: Model, msg: Msg) -> #(Model, Effect(Msg)) {
  case msg {
    // Connection ready → seed channels and start presence.
    Connected(Ok(Nil)) ->
      case model.doc {
        Some(doc) -> #(model, effect.batch([
          bootstrap_effect(doc),
          presence_effect(model, doc),
        ]))
        None -> #(model, effect.none())
      }

    // A channel resolved → keep its handle and subscribe to it.
    EnsuredCards(Ok(cards)) -> #(
      Model(..model, cards: Some(cards)),
      watershed_lustre.subscribe(cards, fn(_event) { SharedChanged }),
    )

    EnsuredCards(Error(reason)) -> #(
      Model(..model, error: Some(reason)),
      effect.none(),
    )

    // Any visible change (optimistic local or applied remote) → re-snapshot.
    SharedChanged -> #(snapshot(model), effect.none())

    // Presence roster changed → re-render the peer markers.
    PeersChanged(peers) -> #(Model(..model, peers:), effect.none())

    _ -> #(model, effect.none())
  }
}`;

const presence = `import watershed/presence
import watershed_lustre

// The heartbeat/TTL presence driver from step 04, as one effect. \`started\`
// hands back a Handle to keep in the model; \`on_peers\` fires with the sorted
// roster whenever the visible peer set changes.
fn presence_effect(model: Model, doc: Document(doc_schema.Board)) -> Effect(Msg) {
  watershed_lustre.presence(
    document: doc,
    user_id: model.user_id,
    config: presence.default_config,
    encode: encode_focus,
    decode: focus_decoder(),
    started: PresenceStarted,
    on_peers: PeersChanged,
  )
}`;
---

<GuideLayout
  slug="ui"
  description="Step five of the watershed build guide: watershed_lustre provides Lustre effects for connections, ensure_* initialization, channel subscriptions, and presence."
>
  <div class="g-block">
    <h2>Declare synchronization with effects</h2>
    <p>
      watershed’s browser facade uses callbacks such as <code>on_ready</code>,
      subscription handlers, and presence <code>on_change</code>. A manual
      Lustre integration must dispatch a message from each callback. Dispatching
      inside <code>update</code> can overwrite the model returned by that update,
      so each callback would need deferral.
    </p>
    <p>
      <a href="https://github.com/tylerbutler/watershed/tree/main/watershed_lustre">
      <code>watershed_lustre</code></a> provides this integration. Each facade
      function becomes a Lustre <code>Effect</code> that dispatches a message
      selected by the application.
    </p>
  </div>

  <div class="g-block">
    <h2>Connect as an effect</h2>
    <p>
      <code>connect</code> becomes an effect that dispatches two messages: the
      <code>Document</code> handle when it is created, and the ready
      <code>Result</code> when the handshake completes. You return it from
      <code>init</code> and handle the messages in <code>update</code>.
    </p>
    <figure class="g-code">
      <Code code={connect} lang="gleam" theme={watershedCodeTheme} />
    </figure>
  </div>

  <div class="g-block">
    <h2>Bootstrap and subscribe</h2>
    <p>
      The <code>ensure_*</code> calls from step 02 are the same here, batched as
      effects. Each channel ensure dispatches its handle back; in
      <code>update</code> you store the handle, take an initial snapshot, and
      subscribe to the channel. Take the snapshot before subscribing.
      Subscriptions report later changes and do not replay existing state.
      Without the snapshot, the user interface starts empty.
      An optimistic local edit dispatches <code>SharedChanged</code> at once. A
      remote edit dispatches the same message when it reaches your replica.
      Both re-snapshot the shared state through one render path.
    </p>
    <span class="g-file">bootstrap</span>
    <figure class="g-code">
      <Code code={bootstrap} lang="gleam" theme={watershedCodeTheme} />
    </figure>
    <span class="g-file">update</span>
    <figure class="g-code">
      <Code code={update} lang="gleam" theme={watershedCodeTheme} />
    </figure>
  </div>

  <div class="g-block">
    <h2>Add presence as an effect</h2>
    <p>
      The presence driver from step 04 is also one effect. Give it the
      payload encoder and decoder. It manages the heartbeat and TTL and calls
      <code>on_peers</code> with the sorted roster whenever the visible peer set
      changes. Always render the markers from that roster.
    </p>
    <figure class="g-code">
      <Code code={presence} lang="gleam" theme={watershedCodeTheme} />
    </figure>
    <div class="g-note">
      <p>
        <strong>View an application.</strong> The <a href="/sudoku">collaborative
        Sudoku demo</a> uses <code>watershed_lustre</code> for connection, typed
        bootstrap, per-channel subscriptions, and live presence cursors. Its
        source is the reference implementation for this step.
      </p>
    </div>
    <div class="g-note">
      <p>
        <strong>Scope effects to their owner.</strong> The shell owns
        document-wide effects (connection, presence, reconnect, diagnostics),
        even when the button that triggers one is inside a single panel.
        Nested components receive a typed map or channel and lift their
        messages into the parent. That keeps a feature runnable both standalone
        and embedded, and prevents duplicate drivers.
      </p>
    </div>
  </div>

  <div class="g-block">
    <h2>Working project files</h2>
    <p>
      The snippets above isolate each lifecycle step. The following files are
      required to run Flowboard. The guide reads them from the example source,
      so the displayed and compiled source stay consistent.
    </p>
    <p>
      Put the files in the structure below, start a floodgate development server on
      port <code>4000</code>, then run <code>pnpm install</code>,
      <code>pnpm build</code>, and <code>pnpm serve</code>. Open
      <code>http://localhost:8080</code> in two tabs to see local edits render
      at once and remote edits arrive through the same subscriptions.
    </p>
    <figure class="g-code">
      <Code
        code={`flowboard_lustre/
├── gleam.toml
├── package.json
├── pnpm-workspace.yaml
├── build.mjs
├── index.html
└── src/
    ├── doc_schema.gleam
    └── flowboard_lustre.gleam`}
        lang="text"
        theme={watershedCodeTheme}
      />
    </figure>

    <p>
      watershed is not published to Hex yet. The two <code>path</code>
      dependencies below resolve because this example is in
      <code>examples/</code> inside a watershed checkout. In your own project,
      add both as Git dependencies at a specific commit. The{" "}
      <a href="https://github.com/tylerbutler/watershed#install">README</a>{" "}
      gives the exact lines.
    </p>

    <span class="g-file">gleam.toml</span>
    <figure class="g-code">
      <Code code={gleamToml} lang="toml" theme={watershedCodeTheme} />
    </figure>

    <span class="g-file">package.json</span>
    <figure class="g-code">
      <Code code={packageJson} lang="json" theme={watershedCodeTheme} />
    </figure>

    <span class="g-file">pnpm-workspace.yaml</span>
    <figure class="g-code">
      <Code code={pnpmWorkspace} lang="yaml" theme={watershedCodeTheme} />
    </figure>

    <span class="g-file">build.mjs</span>
    <figure class="g-code">
      <Code code={buildScript} lang="javascript" theme={watershedCodeTheme} />
    </figure>

    <span class="g-file">index.html</span>
    <figure class="g-code">
      <Code code={indexHtml} lang="html" theme={watershedCodeTheme} />
    </figure>

    <span class="g-file">src/doc_schema.gleam</span>
    <figure class="g-code">
      <Code code={schemaSource} lang="gleam" theme={watershedCodeTheme} />
    </figure>

    <span class="g-file">src/flowboard_lustre.gleam</span>
    <figure class="g-code">
      <Code code={appSource} lang="gleam" theme={watershedCodeTheme} />
    </figure>
  </div>

  <div class="g-out">
    <span class="annot">You can now</span>
    <p>
      Wire a whole document into a Lustre SPA as a handful of declared effects:
      connection, typed initialization, subscriptions, and presence. These
      effects prevent dispatch calls during <code>update</code>.
    </p>
  </div>
</GuideLayout>
