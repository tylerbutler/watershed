---
// Field notes: the practices filed under one build-guide step, rendered at the
// foot of that step's sheet. /patterns indexes these; this component is where
// they actually live. Each note is collapsed to its rule so the notes read as a
// checklist the step ends on, not a second article. Prose styling comes from
// .doc-body in global.css.
import { Code } from "astro:components";
import type { StepSlug } from "../data/guide";
import {
  exampleForPractice,
  practiceExampleName,
  practiceSourceUrl,
  practicesByStep,
} from "../data/practices";
import { watershedCodeTheme } from "../styles/code-theme";

interface Props {
  /** The guide step whose practices to render. */
  step: StepSlug;
}

const { step } = Astro.props;
const notes = practicesByStep[step];
---

{
  notes.length > 0 && (
    <section class="fn" aria-labelledby="fn-title">
      <h2 id="fn-title">How the examples do it</h2>
      <p class="fn-lede">
        Each note connects an implementation practice to a checked-in example.
        Open it for the code and reasoning.
      </p>
      {notes.map((practice) => {
        const exampleName = practiceExampleName(practice);
        const example = exampleForPractice(practice);
        return (
          <details id={practice.id} class="fn-note">
            <summary>
              <h3>{practice.title}</h3>
              <p class="fn-rule">{practice.rule}</p>
            </summary>
            <div class="fn-body">
              {practice.body.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
              <span class="g-file">{practice.snippetFile}</span>
              <figure class="g-code">
                <Code
                  code={practice.snippet}
                  lang={practice.snippetLang === "js" ? "js" : "gleam"}
                  theme={watershedCodeTheme}
                />
                <figcaption class="annot">{exampleName}</figcaption>
              </figure>
              {practice.testNote && (
                <div class="g-note">
                  <p>
                    <strong>The check.</strong> {practice.testNote}
                  </p>
                </div>
              )}
              <p class="fn-evidence">
                <span class="annot">Demonstrated by</span>
                {example ? (
                  <a href={`/examples#${example.id}`}>{exampleName}</a>
                ) : (
                  <span>{exampleName}</span>
                )}
                <a class="fn-source" href={practiceSourceUrl(practice)}>
                  Source &#8599;
                </a>
              </p>
            </div>
          </details>
        );
      })}
    </section>
  )
}

<script>
  // Deep links from /patterns and /examples land on a collapsed note. Browsers
  // that auto-expand `details` on a fragment target are still the minority, so
  // open it here and re-scroll, since opening moves everything below it.
  function revealTargetNote() {
    if (!location.hash) return;
    const target = document.getElementById(
      decodeURIComponent(location.hash.slice(1)),
    );
    const note = target?.closest("details");
    if (!note || note.open) return;
    note.open = true;
    note.scrollIntoView();
  }

  revealTargetNote();
  addEventListener("hashchange", revealTargetNote);
</script>

<style>
  .fn {
    margin-top: var(--space-section);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--ink);
  }

  .fn-lede {
    color: var(--muted);
    margin-bottom: var(--space-xl);
  }

  /* ── collapsed note ────────────────────────────────────────────────────── */
  .fn-note {
    scroll-margin-top: var(--space-lg);
    border-top: 1px solid var(--hairline);
  }

  .fn-note:last-of-type {
    border-bottom: 1px solid var(--hairline);
  }

  .fn-note summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-xs) var(--space-lg);
    padding: var(--space-lg) 0;
    cursor: pointer;
    list-style: none;
  }

  .fn-note summary::-webkit-details-marker {
    display: none;
  }

  .fn-note summary:hover h3,
  .fn-note summary:focus-visible h3 {
    color: var(--overprint-deep);
  }

  .fn-note summary h3 {
    /* Overrides the .doc-body h3 rhythm: inside a summary this is a row, not a
       section opener. */
    margin: 0;
    font-size: 1.15rem;
    line-height: 1.3;
  }

  .fn-note summary::after {
    content: "+";
    grid-row: 1;
    grid-column: 2;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--overprint-deep);
  }

  .fn-note[open] summary::after {
    content: "\2212";
  }

  .fn-rule {
    grid-column: 1;
    margin: 0;
    max-width: 62ch;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  /* ── expanded body ─────────────────────────────────────────────────────── */
  .fn-body {
    padding-bottom: var(--space-xl);
  }

  .fn-evidence {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-xs) var(--space-lg);
    padding: var(--space-md) var(--space-lg);
    border: 1px solid var(--hairline);
    background: var(--surface);
    font-size: var(--text-sm);
  }

  .fn-source {
    margin-left: auto;
    color: var(--waterline);
    text-decoration: none;
  }
</style>
