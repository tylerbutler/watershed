---
import AdjoiningSheets from "./AdjoiningSheets.astro";

const flows = [
  {
    label: "BEAM client",
    source: "watershed",
    sourceHref: "https://github.com/tylerbutler/watershed",
    verb: "opens Phoenix channels with",
    path: [
      {
        name: "aquamarine",
        href: "https://aquamarine.tylerbutler.com",
      },
      {
        name: "roost",
        href: "https://github.com/tylerbutler/roost",
      },
    ],
    target: "floodgate",
    targetHref: "https://floodgate.tylerbutler.com",
    note: "OTP runtime, Gun transport, Roost Phoenix V2 frame codec.",
  },
  {
    label: "Browser client",
    source: "watershed_js",
    sourceHref: "https://github.com/tylerbutler/watershed",
    verb: "opens Phoenix channels with",
    path: [{ name: "Phoenix.js", href: "https://hexdocs.pm/phoenix/js/" }],
    target: "floodgate",
    targetHref: "https://floodgate.tylerbutler.com",
    note: "Gleam JavaScript runtime over transport_js and the browser Web Crypto API.",
  },
  {
    label: "Protocol layer",
    source: "watershed core",
    sourceHref: "https://github.com/tylerbutler/watershed",
    verb: "encodes document messages through",
    path: [
      {
        name: "spillway",
        href: "https://spillway.tylerbutler.com",
      },
    ],
    target: "floodgate",
    targetHref: "https://floodgate.tylerbutler.com",
    note: "Shared operation, session, sequencing, and watershed summary types.",
  },
  {
    label: "Server side",
    source: "floodgate",
    sourceHref: "https://floodgate.tylerbutler.com",
    verb: "hosts rooms and broadcasts through",
    path: [
      {
        name: "beryl",
        href: "https://beryl.tylerbutler.com",
      },
      {
        name: "dewdrop",
        href: "https://dewdrop.tylerbutler.com",
      },
    ],
    target: "clients",
    targetHref: "https://github.com/tylerbutler/watershed",
    note: "Channel runtime plus adapters for sequenced service events.",
  },
];
---

<AdjoiningSheets />

<footer class="eco" aria-labelledby="eco-title">
  <div class="eco-inner">
    <h2 id="eco-title">Packages and protocol boundaries</h2>
    <p>
      The shared DDS core stays target-independent. These paths show which
      packages provide each target’s transport and framing, and which protocol
      types cross the client/server boundary. floodgate is shown as the
      reference server; the same protocol also reaches levee and Fluid
      Framework’s own routerlicious.
    </p>
    <ol class="flow-list" aria-label="Package relationships">
      {
        flows.map((flow) => (
          <li class="flow-row">
            <span class="flow-label annot">{flow.label}</span>
            <div class="flow-line">
              <a href={flow.sourceHref}>
                <code>{flow.source}</code>
              </a>
              <span>{flow.verb}</span>
              <span class="flow-path">
                {flow.path.map((pkg, index) => (
                  <>
                    <a href={pkg.href}>
                      <code>{pkg.name}</code>
                    </a>
                    {index < flow.path.length - 1 && (
                      <span aria-hidden="true">→</span>
                    )}
                  </>
                ))}
              </span>
              <span aria-hidden="true">→</span>
              <a href={flow.targetHref}>
                <code>{flow.target}</code>
              </a>
            </div>
            <p>{flow.note}</p>
          </li>
        ))
      }
    </ol>
    <div class="eco-take">
      <p class="annot eco-take-label">Take it into a project · Gleam ≥ 1.18</p>
      <pre class="dep-line"><code>[dependencies]
watershed = &lbrace; git = "https://github.com/tylerbutler/watershed", ref = "&lt;commit-sha&gt;" &rbrace;</code></pre>
    </div>
    <div class="eco-close">
      <a class="cta-primary" href="https://github.com/tylerbutler/watershed">
        Read the source
      </a>
      <a class="eco-star" href="https://github.com/tylerbutler/watershed/stargazers">
        ★ Star the repo
      </a>
      <span class="annot">MIT · built by Tyler Butler</span>
    </div>
  </div>
</footer>

<style>
  .eco {
    padding: var(--space-section) var(--content-pad)
      clamp(3rem, 6vw, 5rem);
  }

  .eco-inner {
    max-width: 68rem;
    margin-inline: auto;
  }

  h2 {
    font-size: var(--text-h2);
    font-weight: 620;
    font-stretch: 118%;
    letter-spacing: -0.015em;
    line-height: 1.05;
  }

  .eco > .eco-inner > p {
    margin-top: var(--space-lg);
  }

  .flow-list {
    list-style: none;
    margin: var(--space-2xl) 0 0;
    padding: 0;
    border-top: 1px solid var(--ink);
  }

  .flow-row {
    display: grid;
    grid-template-columns: minmax(9rem, 0.34fr) 1fr;
    gap: var(--space-md) var(--space-xl);
    padding: var(--space-lg) 0;
    border-top: 1px solid var(--hairline);
  }

  .flow-row:first-child {
    border-top: 0;
  }

  .flow-row:last-child {
    border-bottom: 1px solid var(--ink);
  }

  .flow-label {
    color: var(--overprint-deep);
    padding-top: 0.08rem;
  }

  .flow-line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-xs) var(--space-sm);
    max-width: 54rem;
  }

  .flow-line code {
    font-size: 1.0625rem;
  }

  .flow-path {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-xs);
    color: var(--muted);
  }

  .flow-row p {
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .flow-row p {
    grid-column: 2;
    margin-top: calc(-1 * var(--space-xs));
  }

  .eco-take {
    margin-top: var(--space-2xl);
  }

  .eco-take-label {
    color: var(--muted);
  }

  .dep-line {
    margin: var(--space-sm) 0 0;
    padding: var(--space-md) var(--space-lg);
    border: 1px solid var(--ink);
    background: var(--bg);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.7;
    overflow-x: auto;
  }

  .eco-star {
    font-weight: 600;
    color: var(--waterline);
    text-decoration: none;
    border-bottom: 1px solid var(--waterline-faint);
  }

  .eco-star:hover {
    color: var(--overprint-deep);
    border-bottom-color: var(--overprint-deep);
  }

  .eco-close {
    margin-top: var(--space-2xl);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-lg);
  }

  .cta-primary {
    display: inline-block;
    padding: 0.8rem 1.6rem;
    background: var(--overprint);
    color: oklch(100% 0 0);
    text-decoration: none;
    font-weight: 600;
    font-stretch: 110%;
    transition: background var(--dur-feedback) var(--ease-out-quart);
  }

  .cta-primary:hover {
    background: var(--overprint-deep);
    color: oklch(100% 0 0);
  }

  @media (max-width: 760px) {
    .flow-row {
      grid-template-columns: 1fr;
      gap: var(--space-sm);
    }

    .flow-row p {
      grid-column: auto;
      margin-top: 0;
    }
  }
</style>
