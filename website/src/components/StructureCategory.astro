---
import Sheet from "../layouts/Sheet.astro";
import Ecosystem from "../components/Ecosystem.astro";
import Demo from "../components/Demo.astro";
import RelatedFieldNotes from "../components/RelatedFieldNotes.astro";
import { categories, structuresBySlug } from "../data/structures";

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const category = structuresBySlug[slug];
if (!category) {
  throw new Error(`Unknown structure category: ${slug}`);
}

const idx = categories.findIndex((c) => c.slug === slug);
const prev = idx > 0 ? categories[idx - 1] : categories[categories.length - 1];
const next =
  idx < categories.length - 1 ? categories[idx + 1] : categories[0];
const familyOrdinal = `Family ${String(idx + 1).padStart(2, "0")}`;

// One rig moves between the family's plates so switching descriptions does
// not reset the kernels. Dedicated demos keep their separate-page links.
const familyViews = category.structures
  .filter((s) => !s.demoHref)
  .map((s) => s.id);
---

<Sheet
  title={`watershed — ${category.name.toLowerCase()}`}
  description={`${category.name} in watershed: ${category.tagline} ${category.structures
    .map((s) => s.name)
    .join(", ")}. How each works, its merge rule, and what it is best for.`}
>
  <header class="cat-hero">
    <div class="cat-hero-inner">
      <p class="eyebrow annot">
        <a href="/">← watershed</a> · <a href="/structures">Data structures</a> /
        {category.name}
      </p>
      <div class="cat-title">
        <h1>{category.name}</h1>
        <span class="cat-index annot" aria-hidden="true">{familyOrdinal}</span>
      </div>
      <p class="cat-tagline">{category.tagline}</p>
      {category.lede.map((para) => <p class="lede">{para}</p>)}

      <nav class="jump" aria-label={`${category.name} in this family`}>
        {
          category.structures.map((s) => (
            <a href={`#${s.id}`}>
              <code>{s.name}</code>
              <span class="jump-kind annot" data-kind={s.kind}>
                {s.kind}
              </span>
            </a>
          ))
        }
      </nav>
    </div>
  </header>

  <main class="plates">
    {
      category.structures.map((s, i) => (
        <article class="plate" id={s.id} data-reveal="rise">
          <div class="plate-mark annot" aria-hidden="true">
            No. {String(i + 1).padStart(2, "0")}
          </div>
          <header class="plate-head">
            <div class="plate-name">
              <h2 id={`${s.id}-title`}>{s.name}</h2>
              <span class="stamp" data-kind={s.kind}>
                {s.kind}
              </span>
            </div>
            <code class="plate-module">{s.module}</code>
            <p class="plate-tagline">{s.tagline}</p>
            {
              s.demoHref && (
                <a class="plate-demo" href={s.demoHref}>
                  Open the live {s.name} demo →
                </a>
              )
            }
            {
              s.id === "mv-register" && (
                <a class="plate-demo" href="/mv-register">
                  Open the revision slate and API notes →
                </a>
              )
            }
            {
              s.id === "map" && (
                <a class="plate-demo" href="/sudoku">
                  Open the live Sudoku cell demo →
                </a>
              )
            }

            {!s.demoHref && (
              <div class="plate-viewbar" data-structure-controls hidden>
                <button
                  type="button"
                  class="plate-toggle"
                  data-structure-toggle={s.id}
                  aria-controls={`${s.id}-demo`}
                  aria-describedby={`${s.id}-title`}
                  aria-expanded="false"
                >
                  Try the live demo ↓
                </button>
              </div>
            )}
          </header>

          <div class="plate-body">
            <div class="plate-prose">
              {s.how.map((para) => (
                <p>{para}</p>
              ))}

              <h3 class="uses-title annot">Best for</h3>
              <ul class="uses">
                {s.useCases.map((use) => (
                  <li>{use}</li>
                ))}
              </ul>
            </div>

            <dl class="spec">
              <div>
                <dt>Merge rule</dt>
                <dd>{s.rule}</dd>
              </div>
              <div>
                <dt>Optimistic behavior</dt>
                <dd>{s.optimistic}</dd>
              </div>
              <div>
                <dt>Summary shape</dt>
                <dd>{s.summary}</dd>
              </div>
              <div>
                <dt>Model</dt>
                <dd>
                  {s.kind === "CRDT"
                    ? "Conflict-free replicated data type: converges by merge"
                    : s.kind === "OT"
                      ? "Operational transform: converges by transforming concurrent operations"
                      : "Distributed data structure: converges by server order"}
                </dd>
              </div>
            </dl>
          </div>

          {!s.demoHref && (
            <Fragment>
              <div
                class="plate-live"
                id={`${s.id}-demo`}
                data-structure-demo
                hidden
              />
              <div id={`${s.id}-after-demo`} tabindex="-1" />
            </Fragment>
          )}
        </article>
      ))
    }
  </main>

  {familyViews.length > 0 && (
    <div data-family-demo hidden>
      <Demo
        views={familyViews}
        initial={familyViews[0]}
        heading={`Live ${category.name.toLowerCase()} demo`}
        otJump={false}
        embedded
      >
        <Fragment slot="intro">
          <p>
            Try an edit on any client, race concurrent writes, or switch on
            jitter. Pending edits print in <strong class="k-pending">magenta</strong>;
            once the sequencer stamps an SN, every replica lands the same
            <strong class="k-seq">ink</strong> state.
          </p>
        </Fragment>
      </Demo>
    </div>
  )}

  <RelatedFieldNotes page={`/structures/${slug}`} />

  <nav class="cat-nav" aria-label="More on data structures">
    <a class="cat-nav-side" href={`/structures/${prev.slug}`}>
      <span class="annot">← Previous family</span>
      <strong>{prev.name}</strong>
    </a>
    <div class="cat-nav-mid">
      <a href="/structures">All families</a>
      <a href="/models">DDS vs CRDT vs OT →</a>
      <a href="/#demo">See it live ↓</a>
    </div>
    <a class="cat-nav-side cat-nav-next" href={`/structures/${next.slug}`}>
      <span class="annot">Next family →</span>
      <strong>{next.name}</strong>
    </a>
  </nav>

  <Ecosystem />
</Sheet>

<script>
  import { initReveals } from "../scripts/motion.js";
  initReveals();

  const demo = document.querySelector<HTMLElement>("[data-family-demo] #demo");
  if (demo) {
    const rig = demo.querySelector<HTMLElement>("[data-demo-rig]");
    const skip = demo.querySelector<HTMLAnchorElement>(".demo-skip");
    if (!rig || !skip) throw new Error("Structure demo markup is incomplete");
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let closeActiveDemo: (() => Promise<void>) | undefined;
    let transitionPending = false;

    const animatePanel = async (panel: HTMLElement, opening: boolean) => {
      panel.getAnimations().forEach((animation) => animation.cancel());
      panel.classList.remove("is-opening", "is-closing");
      if (opening) panel.hidden = false;
      if (reduceMotion.matches) {
        if (!opening) panel.hidden = true;
        return;
      }

      panel.style.setProperty("--panel-height", `${panel.scrollHeight}px`);
      panel.classList.add(opening ? "is-opening" : "is-closing");
      await Promise.allSettled(
        panel.getAnimations().map((animation) => animation.finished),
      );
      panel.classList.remove("is-opening", "is-closing");
      panel.style.removeProperty("--panel-height");
      if (!opening) panel.hidden = true;
    };

    for (const button of document.querySelectorAll<HTMLButtonElement>("[data-structure-toggle]")) {
      const id = button.dataset.structureToggle;
      const plate = button.closest(".plate");
      const controls = plate?.querySelector<HTMLElement>("[data-structure-controls]");
      const description = plate?.querySelector<HTMLElement>(".plate-body");
      const panel = plate?.querySelector<HTMLElement>("[data-structure-demo]");
      const pick = demo.querySelector<HTMLInputElement>(`[data-dds-pick][value="${id}"]`);
      if (!controls || !description || !panel || !pick || !id) {
        throw new Error(`Structure demo markup is incomplete for ${id}`);
      }

      const close = async () => {
        await animatePanel(panel, false);
        description.hidden = false;
        button.setAttribute("aria-expanded", "false");
        button.textContent = "Try the live demo ↓";
      };

      button.addEventListener("click", async () => {
        if (transitionPending) return;
        transitionPending = true;
        try {
          if (!panel.hidden) {
            await close();
            closeActiveDemo = undefined;
            return;
          }
          await closeActiveDemo?.();
          panel.append(demo);
          description.hidden = true;
          button.setAttribute("aria-expanded", "true");
          button.textContent = "Close demo ↑";
          skip.href = `#${id}-after-demo`;
          // The dataset also records a selection made before the kernels load.
          rig.dataset.dds = id;
          pick.checked = true;
          pick.dispatchEvent(new Event("change", { bubbles: true }));
          closeActiveDemo = close;
          await animatePanel(panel, true);
          button.scrollIntoView({ block: "nearest" });
        } finally {
          transitionPending = false;
        }
      });
      controls.hidden = false;
    }
  }
</script>

<style>
  /* ── hero ─────────────────────────────────────────────────────────────── */
  .cat-hero {
    padding: clamp(3rem, 8vw, 6.5rem) var(--content-pad) clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--hairline);
    background:
      linear-gradient(var(--hairline-faint) 1px, transparent 1px),
      linear-gradient(90deg, var(--hairline-faint) 1px, transparent 1px),
      var(--surface);
    background-size: 3.5rem 3.5rem;
  }

  .cat-hero-inner {
    max-width: 68rem;
    margin-inline: auto;
  }

  .eyebrow {
    color: var(--muted);
    margin: 0 0 var(--space-lg);
  }

  .eyebrow a {
    color: var(--waterline);
    text-decoration: none;
  }

  .eyebrow a:hover {
    color: var(--overprint-deep);
  }

  .cat-title {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm) var(--space-lg);
    flex-wrap: wrap;
  }

  h1 {
    font-size: var(--text-display);
    font-weight: 640;
    font-stretch: 122%;
    line-height: 0.99;
    letter-spacing: -0.025em;
    overflow-wrap: break-word;
  }

  @media (max-width: 30rem) {
    h1 {
      font-size: clamp(2.1rem, 10vw, 2.7rem);
      font-stretch: 100%;
      letter-spacing: -0.03em;
    }
  }

  .cat-index {
    color: var(--overprint-deep);
    white-space: nowrap;
  }

  .cat-tagline {
    margin-top: var(--space-md);
    font-size: clamp(1.2rem, 0.8vw + 1rem, 1.5rem);
    font-stretch: 112%;
    color: var(--ink);
    max-width: 40ch;
  }

  .lede {
    margin-top: var(--space-lg);
    font-size: clamp(1.0625rem, 0.4vw + 1rem, 1.2rem);
    line-height: 1.6;
    max-width: 60ch;
    color: var(--ink);
  }

  .jump {
    margin-top: var(--space-xl);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .jump a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--ink);
    background: var(--bg);
    text-decoration: none;
    color: var(--ink);
    transition:
      background var(--dur-feedback) var(--ease-out-quart),
      color var(--dur-feedback) var(--ease-out-quart);
  }

  .jump a:hover {
    background: var(--ink);
    color: var(--bg);
  }

  .jump a:hover code {
    color: var(--bg);
  }

  .jump code {
    font-size: 0.9rem;
    color: var(--ink);
  }

  .jump-kind {
    font-size: 0.66rem;
  }

  .jump-kind[data-kind="CRDT"] {
    color: var(--waterline);
  }

  .jump-kind[data-kind="DDS"] {
    color: var(--muted);
  }

  .jump a:hover .jump-kind {
    color: var(--bg);
  }

  /* ── plates ───────────────────────────────────────────────────────────── */
  .plates {
    max-width: 68rem;
    margin-inline: auto;
    padding: var(--space-2xl) var(--content-pad);
    display: grid;
    gap: var(--space-2xl);
  }

  .plate {
    position: relative;
    border: 1px solid var(--ink);
    background: var(--bg);
    padding: clamp(var(--space-lg), 3vw, var(--space-2xl));
    min-width: 0;
  }

  .plate-mark {
    position: absolute;
    top: var(--space-md);
    right: var(--space-md);
    color: var(--muted);
  }

  .plate-head {
    padding-right: 4rem;
    border-bottom: 1px solid var(--hairline);
    padding-bottom: var(--space-lg);
  }

  .plate-name {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  h2 {
    font-size: var(--text-h2);
    font-weight: 630;
    font-stretch: 116%;
    letter-spacing: -0.015em;
    line-height: 1.05;
    overflow-wrap: anywhere;
  }

  .stamp {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.18rem 0.5rem;
    border: 1.5px solid currentColor;
    color: var(--muted);
    transform: rotate(-2deg);
  }

  .stamp[data-kind="CRDT"] {
    color: var(--waterline);
  }

  .stamp[data-kind="DDS"] {
    color: var(--ink);
  }

  .stamp[data-kind="OT"] {
    color: var(--overprint-deep);
  }

  .plate-module {
    display: inline-block;
    margin-top: var(--space-sm);
    color: var(--overprint-deep);
    font-size: 0.85rem;
  }

  .plate-tagline {
    margin-top: var(--space-sm);
    color: var(--muted);
    font-size: var(--text-body);
    max-width: 54ch;
  }

  .plate-demo {
    display: inline-block;
    margin-top: var(--space-md);
    font-weight: 600;
    color: var(--waterline);
    text-decoration: none;
  }

  .plate-demo:hover {
    color: var(--overprint-deep);
  }

  .plate-viewbar {
    display: flex;
    align-items: center;
    margin-top: var(--space-lg);
  }

  .plate-toggle {
    min-height: 3rem;
    min-width: 13rem;
    padding: var(--space-sm) var(--space-lg);
    border: 1px solid var(--ink);
    background: var(--ink);
    color: var(--bg);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 700;
    cursor: pointer;
    transition:
      background var(--dur-feedback) var(--ease-out-quart),
      border-color var(--dur-feedback) var(--ease-out-quart),
      color var(--dur-feedback) var(--ease-out-quart),
      transform var(--dur-feedback) var(--ease-out-quart);
  }

  .plate-toggle:hover {
    border-color: var(--waterline);
    background: var(--waterline);
  }

  .plate-toggle[aria-expanded="true"] {
    background: var(--bg);
    color: var(--ink);
  }

  .plate-toggle[aria-expanded="true"]:hover {
    background: var(--surface);
  }

  .plate-toggle:active {
    transform: translateY(1px);
  }

  .plate-toggle:focus-visible {
    outline: 2px solid var(--waterline);
    outline-offset: 3px;
  }

  .plate-live {
    margin-top: var(--space-lg);
    transform-origin: top;
    overflow: clip;
  }

  .plate-live.is-opening {
    animation: plate-panel-open 320ms var(--ease-out-expo) both;
  }

  .plate-live.is-closing {
    animation: plate-panel-close 220ms var(--ease-out-quart) both;
  }

  @keyframes plate-panel-open {
    from {
      block-size: 0;
      opacity: 0;
      clip-path: inset(0 0 100% 0);
      transform: translateY(-0.75rem);
    }

    to {
      block-size: var(--panel-height);
      opacity: 1;
      clip-path: inset(0);
      transform: translateY(0);
    }
  }

  @keyframes plate-panel-close {
    from {
      block-size: var(--panel-height);
      opacity: 1;
      clip-path: inset(0);
      transform: translateY(0);
    }

    to {
      block-size: 0;
      opacity: 0;
      clip-path: inset(0 0 100% 0);
      transform: translateY(-0.5rem);
    }
  }

  .k-pending {
    color: var(--overprint-deep);
  }

  .plate-viewbar[hidden],
  .plate-body[hidden] {
    display: none;
  }

  @media (max-width: 36rem) {
    .plate-toggle {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .plate-toggle {
      transition: none;
    }
  }

  .plate-body {
    margin-top: var(--space-lg);
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(15rem, 1fr);
    gap: clamp(var(--space-lg), 4vw, var(--space-2xl));
    align-items: start;
  }

  .plate-prose p {
    max-width: 60ch;
    color: var(--ink);
  }

  .plate-prose p + p {
    margin-top: var(--space-md);
  }

  .uses-title {
    margin: var(--space-xl) 0 var(--space-sm);
    color: var(--overprint-deep);
  }

  .uses {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-xs);
  }

  .uses li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--ink);
    font-size: var(--text-sm);
    max-width: 58ch;
  }

  .uses li::before {
    content: "▸";
    position: absolute;
    left: 0;
    color: var(--waterline);
  }

  .spec {
    margin: 0;
    border: 1px solid var(--ink);
    background: var(--surface);
    position: relative;
  }

  .spec::after {
    content: "";
    position: absolute;
    inset: var(--space-xs);
    border: 1px dashed var(--hairline);
    pointer-events: none;
  }

  .spec div {
    position: relative;
    z-index: 1;
    padding: var(--space-md) var(--space-lg);
  }

  .spec div + div {
    border-top: 1px solid var(--hairline);
  }

  .spec dt {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .spec dd {
    margin: var(--space-2xs) 0 0;
    color: var(--ink);
    font-size: var(--text-sm);
    line-height: 1.5;
    text-wrap: pretty;
  }

  /* ── bottom nav ───────────────────────────────────────────────────────── */
  .cat-nav {
    max-width: 68rem;
    margin-inline: auto;
    padding: var(--space-xl) var(--content-pad) var(--space-2xl);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-lg);
    border-top: 1px solid var(--hairline);
  }

  .cat-nav-side {
    display: grid;
    gap: 0.1rem;
    text-decoration: none;
    color: var(--ink);
  }

  .cat-nav-side .annot {
    color: var(--muted);
  }

  .cat-nav-side strong {
    font-stretch: 112%;
    font-weight: 620;
    color: var(--waterline);
  }

  .cat-nav-side:hover strong {
    color: var(--overprint-deep);
  }

  .cat-nav-next {
    text-align: right;
    justify-items: end;
  }

  .cat-nav-mid {
    display: grid;
    gap: var(--space-2xs);
    justify-items: center;
    text-align: center;
    font-size: var(--text-sm);
  }

  @media (max-width: 720px) {
    .plate-body {
      grid-template-columns: 1fr;
    }

    .cat-nav {
      grid-template-columns: 1fr;
      justify-items: start;
      gap: var(--space-lg);
    }

    .cat-nav-next {
      text-align: left;
      justify-items: start;
    }

    .cat-nav-mid {
      justify-items: start;
      text-align: left;
      order: 3;
    }
  }

  @media (max-width: 480px) {
    .plate {
      padding: var(--space-lg) var(--space-md);
    }

    .plate-head {
      padding-right: 2.75rem;
    }

    .plate-mark {
      top: var(--space-sm);
      right: var(--space-sm);
    }

    h2 {
      font-size: clamp(1.5rem, 6.5vw, 1.9rem);
    }
  }
</style>
