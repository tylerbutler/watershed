---
import { Code } from "astro:components";
import { watershedCodeTheme } from "../styles/code-theme";

const sample = `import gleam/erlang/process
import gleam/io
import gleam/json
import watershed
import watershed/map_kernel.{type MapEvent, ValueChanged}

type Msg {
  MapChanged(MapEvent)
}

pub fn main() {
  // Connect, blocking until the op history has replayed locally. \`connect\`
  // returns a Result — asserted here for brevity; a supervised app matches
  // the Error case and lets OTP restart the link.
  let assert Ok(doc) =
    watershed.connect(
      host: "127.0.0.1",
      port: 4000,
      tenant: "dev-tenant",
      document: "river-gauges",
      token: token,
      user_id: "gauge-1",
    )
  let gauges = watershed.root(doc)

  let selector =
    process.new_selector()
    |> process.select_map(watershed.subscribe(gauges), MapChanged)

  // Optimistic write: applies now and emits locally, then goes to the server.
  watershed.set(gauges, "mill-race", json.int(24))

  let MapChanged(event) = process.selector_receive_forever(selector)
  case event {
    ValueChanged(key:, ..) -> io.println("revised: " <> key)
    _ -> Nil
  }
}`;
---

<section class="code-sample" aria-labelledby="code-title">
  <div class="code-inner">
    <div class="code-prose">
      <h2 id="code-title">A map over one sequenced stream</h2>
      <p>
        <code>SharedMap</code> exposes familiar operations: <code>set</code>,
        <code>get</code>, <code>subscribe</code>. There is no merge callback to
        install: local writes apply optimistically, the server assigns their
        sequence numbers, and the highest-sequenced write wins per key.
      </p>
      <p>
        The same API runs on the Erlang target as an OTP actor and on the
        JavaScript target inside a Lustre single-page app: see{" "}
        <a href="https://github.com/tylerbutler/watershed/tree/main/examples"
          >the examples</a
        > for both, verified converging against a live floodgate sequencer.
      </p>
      <p class="code-cta">
        <a href="/guide"
          >Build an app, step by step: the field guide →</a
        >
      </p>
    </div>
    <figure class="code-figure" data-reveal="rise">
      <Code code={sample} lang="gleam" theme={watershedCodeTheme} />
      <figcaption class="annot">examples · erlang + javascript targets</figcaption>
    </figure>
  </div>
</section>

<style>
  .code-sample {
    padding: var(--space-section) var(--content-pad);
    border-bottom: 1px solid var(--hairline);
  }

  /* Prose above, code panel at full content width below: a Gleam dev
     evaluating the API should never have to sideways-scroll the sample on a
     large monitor while half the row sits empty. */
  .code-inner {
    max-width: 68rem;
    margin-inline: auto;
  }

  .code-prose {
    max-width: 62ch;
  }

  h2 {
    font-size: var(--text-h2);
    font-weight: 620;
    font-stretch: 118%;
    letter-spacing: -0.015em;
    line-height: 1.05;
  }

  .code-prose p {
    margin-top: var(--space-lg);
  }

  .code-prose code {
    font-size: 0.85em;
  }

  .code-cta {
    margin-top: var(--space-xl);
  }

  .code-cta a {
    font-weight: 600;
    font-stretch: 108%;
    color: var(--overprint-deep);
    text-decoration: none;
    border-bottom: 1px solid var(--overprint-faint);
    transition: border-color var(--dur-feedback) var(--ease-out-quart);
  }

  .code-cta a:hover {
    border-bottom-color: var(--overprint-deep);
  }

  .code-figure {
    margin: var(--space-xl) 0 0;
    min-width: 0;
  }

  .code-figure :global(pre) {
    margin: 0;
    padding: var(--space-lg);
    border: 1px solid var(--ink);
    overflow-x: auto;
    font-size: 0.875rem;
    line-height: 1.7;
  }

  figcaption {
    margin-top: var(--space-sm);
    text-align: right;
  }

</style>
