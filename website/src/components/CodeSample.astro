---
import SnippetBlock from "./SnippetBlock.astro";
import { standaloneSnippets } from "../data/standalone-snippets.ts";

const sample = standaloneSnippets["homepage-beam"];
---

<section class="code-sample" aria-labelledby="code-title">
  <div class="code-inner">
    <div class="code-prose">
      <h2 id="code-title">A map over one sequenced stream</h2>
      <p>
        <code>connect</code> hands back a document, <code>root</code> hands back
        its <code>SharedMap</code>, and <code>subscribe</code> hands back a
        stream of changes to select on. Below is that whole opening move from
        the dice CLI — connect, take the root, subscribe, print the entries
        already there, then loop. No merge callback appears anywhere in it,
        because there is none to install: the server sequences every write, and
        the highest-sequenced write wins per key.
      </p>
      <p>
        The same core runs on the Erlang target as an OTP actor and on the
        JavaScript target inside a Lustre single-page app. The facades differ
        at the edge: <code>watershed_beam</code> blocks and returns a{" "}
        <code>Subject</code>, as it does here, while <code>watershed</code> uses
        callbacks. See{" "}
        <a href="https://github.com/tylerbutler/watershed/tree/main/examples"
          >the examples</a
        > for both, verified converging against a live floodgate sequencer.
      </p>
      <p class="code-cta">
        <a href="/guide"
          >Build an app, step by step: the field guide →</a
        >
      </p>
    </div>
    <div class="code-figure" data-reveal="rise">
      <SnippetBlock snippet={sample}>
        <figcaption slot="caption" class="annot">erlang target</figcaption>
      </SnippetBlock>
    </div>
  </div>
</section>

<style>
  .code-sample {
    padding: var(--space-section) var(--content-pad);
    border-bottom: 1px solid var(--hairline);
  }

  /* Prose above, code panel at full content width below: a Gleam dev
     evaluating the API should never have to sideways-scroll the sample on a
     large monitor while half the row sits empty. */
  .code-inner {
    max-width: 68rem;
    margin-inline: auto;
  }

  .code-prose {
    max-width: 62ch;
  }

  h2 {
    font-size: var(--text-h2);
    font-weight: 620;
    font-stretch: 118%;
    letter-spacing: -0.015em;
    line-height: 1.05;
  }

  .code-prose p {
    margin-top: var(--space-lg);
  }

  .code-prose code {
    font-size: 0.85em;
  }

  .code-cta {
    margin-top: var(--space-xl);
  }

  .code-cta a {
    font-weight: 600;
    font-stretch: 108%;
    color: var(--overprint-deep);
    text-decoration: none;
    border-bottom: 1px solid var(--overprint-faint);
    transition: border-color var(--dur-feedback) var(--ease-out-quart);
  }

  .code-cta a:hover {
    border-bottom-color: var(--overprint-deep);
  }

  /* The figure and its file chip come from SnippetBlock, so they carry that
     component's scope, not this one's: `:global()` is how a parent reaches
     them. The homepage is not a `.doc-body`, so the shared `.g-*` grammar in
     global.css does not apply here either — these rules are the survey-sheet
     look, restated for the landing page. */
  .code-figure {
    margin: var(--space-xl) 0 0;
    min-width: 0;
  }

  .code-figure :global(.g-file) {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: var(--space-sm);
    padding: 0.28rem 0.6rem;
    border: 1px solid var(--hairline);
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: var(--text-annot);
    color: var(--ink);
    text-decoration: none;
  }

  .code-figure :global(.g-file::before) {
    content: "▸";
    color: var(--overprint);
  }

  .code-figure :global(.g-code) {
    margin: 0;
    min-width: 0;
  }

  .code-figure :global(pre) {
    margin: 0;
    padding: var(--space-lg);
    border: 1px solid var(--ink);
    overflow-x: auto;
    font-size: 0.875rem;
    line-height: 1.7;
  }

  .code-figure :global(figcaption) {
    margin-top: var(--space-sm);
    text-align: right;
  }
</style>
