---
const clients = [
  { id: "a", name: "Client A" },
  { id: "b", name: "Client B" },
];
---

<section
  id="guide-race-demo"
  class="gr"
  aria-labelledby="guide-race-title"
>
  <div class="gr-head" data-reveal="rise">
    <h2 id="guide-race-title">See the race before you build it.</h2>
    <p>
      This guide’s retro board is not a merge sketch. Two real
      <code>watershed</code> documents talk to the in-memory <code>sluice</code>
      and run the same two OR-map rules the later sheets wire into the tutorial
      project: whole notes in one register OR-map, vote totals in one tally
      OR-map.
    </p>
    <p class="gr-hint">
      Press one race, then watch the colors do the arguing. A local add or tally
      shows up in <strong class="k-pending">magenta</strong> while it is still
      pending on that replica. Once the sequencer stamps it, every replica inks
      the same board. The note race keeps both cards; the vote race throws
      <code>+1</code>, <code>+1</code>, and <code>-1</code> at one note and
      settles at <code>+1</code>. Reset between runs.
    </p>
  </div>

  <div class="gr-rig" data-guide-race-rig>
    {
      clients.map((client) => (
        <article
          class="gr-client"
          data-client={client.id}
          aria-label={`${client.name} retro board replica`}
          style={`grid-area: ${client.id}`}
        >
          <header class="gr-client-head">
            <h3>{client.name}</h3>
            <span class="pending-count annot" data-pending-count>0 pending</span>
          </header>

          <div class="gr-board">
            <header class="gr-lane-head">
              <div>
                <h4>Went well</h4>
                <p class="annot">add-wins notes · signed vote tally</p>
              </div>
              <span class="annot" data-note-count>1 note</span>
            </header>
            <div data-board></div>
          </div>
        </article>
      ))
    }

    <div class="gr-channel" style="grid-area: seq">
      <div class="gr-seq-node" data-seq-node>
        <span class="annot">Sequencer</span>
        <output
          class="gr-seq-counter"
          data-seq-counter
          aria-label="Latest sequence number"
        >
          SN&nbsp;0
        </output>
      </div>
      <ol
        class="gr-op-log"
        data-op-log
        aria-live="polite"
        aria-label="Sequenced operations, newest first"
      ></ol>
    </div>

    <div class="flow-layer" data-flow-layer aria-hidden="true"></div>
  </div>

  <div class="gr-controls" data-reveal="rise">
    <label class="gr-latency">
      <span class="annot">Link latency</span>
      <input
        type="range"
        min="100"
        max="2000"
        step="100"
        value="700"
        data-guide-race-latency
        disabled
      />
      <output data-guide-race-latency-out>700 ms</output>
    </label>

    <button type="button" class="race-btn" data-guide-race-add disabled>
      Add two notes at once
    </button>
    <button type="button" class="race-btn" data-guide-race-votes disabled>
      Cast three votes
    </button>
    <button
      type="button"
      class="reset-btn"
      data-guide-race-reset
      aria-label="Reset the retro board race demo"
      disabled
    >
      Reset
    </button>

    <p class="status" data-guide-race-status role="status">
      <span class="stamp converged">Converged</span>
      all replicas identical · nothing pending
    </p>
  </div>

  <p class="gr-controls-hint">
    Each button runs one clean race. Reset restores the standing note so the
    other race starts from the same board.
  </p>

  <noscript>
    <p class="demo-noscript">
      The live race needs JavaScript: it runs two real
      <code>watershed</code> documents against the in-memory <code>sluice</code>
      as compiled JavaScript in your browser. The rest of the page works fine
      without it.
    </p>
  </noscript>

  <p class="demo-noscript" data-guide-race-fallback hidden>
    The live race couldn’t start: it runs two real <code>watershed</code>
    documents against the in-memory <code>sluice</code> as compiled JavaScript,
    and this browser didn’t load it. The rest of the page works fine without
    it.
  </p>
</section>

<script>
  try {
    const { initGuideRaceDemo } = await import("../scripts/guide-race-demo.ts");
    initGuideRaceDemo();
  } catch (error) {
    console.error("watershed guide race demo failed to start", error);
    const note = document.querySelector("[data-guide-race-fallback]");
    if (note instanceof HTMLElement) note.hidden = false;
  }
</script>

<style>
  .gr {
    padding: var(--space-section) var(--content-pad);
    border-bottom: 1px solid var(--hairline);
  }

  .gr-head {
    max-width: 68rem;
    margin-inline: auto;
  }

  .gr h2 {
    font-size: var(--text-h2);
    font-weight: 620;
    font-stretch: 118%;
    letter-spacing: -0.015em;
    line-height: 1.05;
  }

  .gr-head p {
    margin-top: var(--space-lg);
    max-width: 64ch;
  }

  .gr-hint {
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .k-pending {
    color: var(--overprint-deep);
  }

  .gr-rig {
    position: relative;
    max-width: 68rem;
    margin: var(--space-xl) auto 0;
    display: grid;
    grid-template-areas: "a seq b";
    grid-template-columns: 1fr minmax(9rem, 0.55fr) 1fr;
    gap: var(--space-lg);
    align-items: start;
  }

  .gr-client {
    border: 1px solid var(--ink);
    background: var(--bg);
    display: flex;
    flex-direction: column;
  }

  .gr-client-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-md);
    padding: var(--space-sm) var(--space-md);
    border-bottom: 1px solid var(--hairline);
  }

  .gr-client-head h3 {
    font-size: 1rem;
    font-weight: 650;
    font-stretch: 115%;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }

  .pending-count {
    color: var(--muted);
    transition: color var(--dur-state) var(--ease-out-quart);
  }

  .pending-count.is-pending {
    color: var(--overprint-deep);
  }

  .gr-board {
    margin: var(--space-md);
    border: 1px solid var(--hairline);
    background: var(--surface);
  }

  .gr-lane-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-md);
    padding: var(--space-sm) var(--space-md);
    border-bottom: 1px solid var(--hairline);
  }

  .gr-lane-head h4 {
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }

  .gr-lane-head p {
    margin: 0.15rem 0 0;
    color: var(--muted);
  }

  .gr-board :global(.gr-notes) {
    list-style: none;
    margin: 0;
    padding: var(--space-md);
    display: grid;
    gap: var(--space-sm);
  }

  .gr-board :global(.gr-note) {
    padding: 0.85rem 0.9rem;
    border: 1px solid var(--ink);
    background: var(--bg);
    display: grid;
    gap: var(--space-sm);
    transition:
      background var(--dur-feedback) var(--ease-out-quart),
      border-color var(--dur-state) var(--ease-out-quart),
      color var(--dur-state) var(--ease-out-quart),
      transform var(--dur-feedback) var(--ease-out-quart);
  }

  .gr-board :global(.gr-note.is-sequenced) {
    color: var(--ink);
  }

  .gr-board :global(.gr-note.is-note-pending) {
    color: var(--overprint-deep);
    background: var(--overprint-faint);
    border-color: var(--overprint);
    transform: rotate(-0.4deg);
  }

  .gr-board :global(.gr-note-text) {
    margin: 0;
    line-height: 1.45;
    font-weight: 550;
  }

  .gr-board :global(.gr-note-meta) {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-sm);
    color: var(--muted);
  }

  .gr-board :global(.gr-vote-wrap) {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .gr-board :global(.gr-vote) {
    min-width: 3ch;
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--hairline);
    background: var(--bg);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-variant-numeric: tabular-nums;
    text-align: center;
  }

  .gr-board :global(.gr-vote.k-pending) {
    color: var(--overprint-deep);
    border-color: var(--overprint);
    background: var(--overprint-faint);
  }

  .gr-board :global(.gr-vote.k-seq) {
    color: var(--ink);
    border-color: var(--ink);
  }

  .gr-channel {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    padding-top: clamp(var(--space-md), 5vw, 3rem);
  }

  .gr-seq-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2xs);
    padding: var(--space-sm) var(--space-lg);
    border: 1px solid var(--ink);
    border-radius: 999px;
    background: var(--bg);
  }

  .gr-seq-counter {
    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }

  .gr-seq-counter.stamped {
    animation: stamp 380ms var(--ease-out-quart);
  }

  @keyframes stamp {
    0% {
      color: var(--overprint);
      transform: scale(1.12);
    }

    100% {
      color: var(--ink);
      transform: none;
    }
  }

  .gr-op-log {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.6;
    color: var(--muted);
    overflow: hidden;
    max-height: 12.5rem;
    mask-image: linear-gradient(black 55%, transparent 96%);
  }

  .gr-op-log :global(li) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.4rem;
    justify-content: center;
    padding: 0.12rem 0;
  }

  .gr-op-log :global(.op-meta) {
    color: var(--muted);
  }

  .gr-op-log :global(.op-path) {
    color: var(--waterline);
  }

  .gr-op-log :global(.op-kind) {
    color: var(--ink);
  }

  .gr-op-log :global(li:first-child .op-meta) {
    color: var(--ink);
  }

  .flow-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: var(--z-flow);
  }

  :global(.flow-dot) {
    position: absolute;
    top: 0;
    left: 0;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--overprint);
  }

  :global(.flow-dot.sequenced) {
    background: var(--ink);
  }

  :global(.flow-dot-label) {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 4px);
    transform: translateX(-50%);
    white-space: nowrap;
    font-size: 0.625rem;
    line-height: 1;
    font-weight: 600;
    letter-spacing: 0.01em;
    padding: 2px 5px;
    border-radius: 4px;
    color: var(--bg);
    background: var(--overprint);
  }

  :global(.flow-dot.sequenced .flow-dot-label) {
    background: var(--ink);
  }

  .gr-controls {
    max-width: 68rem;
    margin: var(--space-xl) auto 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xl);
  }

  .gr-latency {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .gr-latency input {
    accent-color: var(--overprint);
    width: clamp(8rem, 18vw, 14rem);
  }

  .gr-latency output {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    min-width: 5ch;
  }

  .race-btn {
    padding: 0.65rem 1.2rem;
    border: 1px solid var(--ink);
    background: var(--bg);
    font-weight: 600;
    cursor: pointer;
    transition:
      background var(--dur-feedback) var(--ease-out-quart),
      transform var(--dur-feedback) var(--ease-out-quart);
  }

  .race-btn:hover:enabled {
    background: var(--overprint-faint);
  }

  .race-btn:active:enabled {
    transform: scale(0.97);
  }

  .reset-btn {
    padding: 0.65rem 1.2rem;
    border: 1px solid var(--hairline);
    background: var(--bg);
    color: var(--muted);
    font-weight: 400;
    cursor: pointer;
    transition:
      background var(--dur-feedback) var(--ease-out-quart),
      color var(--dur-feedback) var(--ease-out-quart),
      transform var(--dur-feedback) var(--ease-out-quart);
  }

  .reset-btn:hover:enabled {
    background: var(--surface);
    color: var(--ink);
  }

  .reset-btn:active:enabled {
    transform: scale(0.97);
  }

  .race-btn:disabled,
  .reset-btn:disabled {
    opacity: 0.45;
    cursor: default;
  }

  .status {
    font-size: var(--text-sm);
    color: var(--muted);
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .status :global(.stamp) {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    padding: 0.2rem 0.55rem;
    border: 1.5px solid currentColor;
    transform: rotate(-2deg);
  }

  .status :global(.stamp.converged) {
    color: var(--waterline);
  }

  .status :global(.stamp.revising) {
    color: var(--overprint-deep);
  }

  .gr-controls-hint {
    max-width: 68rem;
    margin: var(--space-sm) auto 0;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .demo-noscript {
    max-width: 68rem;
    margin: var(--space-lg) auto 0;
    color: var(--overprint-deep);
  }

  @media (max-width: 1080px) {
    .gr-rig {
      grid-template-areas: "a" "seq" "b";
      grid-template-columns: 1fr;
    }

    .gr-op-log {
      max-height: 5.7rem;
    }
  }

  @media (max-width: 36rem) {
    .gr-lane-head,
    .gr-client-head {
      flex-direction: column;
      align-items: flex-start;
    }

    .gr-board :global(.gr-note-meta) {
      align-items: flex-start;
    }
  }

  @media (pointer: coarse) {
    .race-btn,
    .reset-btn {
      padding: 0.85rem 1.2rem;
    }
  }
</style>
