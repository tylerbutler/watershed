---
import { structureLinks, categories } from "../data/structures";

// One representative sheet per family — the homepage teases the breadth without
// enumerating all twelve. The full catalog lives on the /structures/* pages.
const featuredNames = ["SharedMap", "SharedCounter", "OrSet", "Claims"];
const allStructures = categories.flatMap((c) => c.structures);
const featured = featuredNames.map(
  (name) => allStructures.find((dds) => dds.name === name)!,
);

const flow = [
  {
    step: "1",
    title: "Submit",
    detail:
      "A client makes a change and updates its local copy.",
  },
  {
    step: "2",
    title: "Sequence",
    detail:
      "A server such as floodgate puts all changes in one order and sends them to each client.",
  },
  {
    step: "3",
    title: "Confirm and apply",
    detail:
      "The source client confirms the change. Each other client applies it with the same code.",
  },
  {
    step: "4",
    title: "Summarize",
    detail:
      "A saved snapshot lets any client load the current state after a new connection or reconnection.",
  },
];
---

<section id="after-demo" class="dds-field" aria-labelledby="dds-field-title">
  <div class="dds-inner">
    <div class="dds-copy">
      <h2 id="dds-field-title">One ordered stream, one clear rule per structure</h2>
      <p>
        watershed does not use one merge rule for all conflicts. Each structure
        defines when local changes appear, when the server must confirm them,
        and which data a client saves for later use.
      </p>
      <p class="dds-atlas-note">
        This page shows a subset of watershed’s structures. The{" "}
        <a href="/structures">data structure catalog</a> groups all structures
        by family and provides a live demo for each one.
      </p>
      <nav class="family-nav" aria-label="Convergence models compared">
        <a class="family-nav-models" href="/models">DDS vs CRDT vs OT →</a>
      </nav>
    </div>

    <div class="sheet-stack" aria-label="Featured DDS kernels">
      {
        featured.map((dds) => (
          <article class="field-sheet" data-reveal="rise">
            <header>
              <div>
                <h3>{dds.name}</h3>
              </div>
              <code>{dds.module}</code>
            </header>
            <dl>
              <div>
                <dt>Merge rule</dt>
                <dd>{dds.rule}</dd>
              </div>
              <div>
                <dt>Before confirmation</dt>
                <dd>{dds.optimistic}</dd>
              </div>
              <div>
                <dt>Saved data</dt>
                <dd>{dds.summary}</dd>
              </div>
            </dl>
            <a
              class="field-detail annot"
              href={`/structures/${structureLinks[dds.name].slug}#${structureLinks[dds.name].id}`}
            >
              Read details →
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="dds-flow" aria-labelledby="dds-flow-title">
  <div class="flow-inner">
    <h2 id="dds-flow-title">All structures use the same change stream</h2>
    <p>
      Every structure above uses the same ordered change stream as the live
      SharedMap demo. A document can host several structures as separate
      channels. All channels share the document’s sequence.
    </p>

    <ol class="flow-steps">
      {
        flow.map((item) => (
          <li data-reveal="settle">
            <span class="flow-step annot">0{item.step}</span>
            <div class="flow-step-body">
              <h3>{item.title}</h3>
              <p>{item.detail}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .dds-field,
  .dds-flow {
    padding: var(--space-section) var(--content-pad);
    border-bottom: 1px solid var(--hairline);
  }

  .dds-field {
    background:
      linear-gradient(var(--hairline-faint) 1px, transparent 1px),
      linear-gradient(90deg, var(--hairline-faint) 1px, transparent 1px),
      var(--surface);
    background-size: 3.5rem 3.5rem;
  }

  .dds-inner,
  .flow-inner {
    max-width: 68rem;
    margin-inline: auto;
  }

  .dds-inner {
    display: grid;
    grid-template-columns: minmax(15rem, 0.8fr) minmax(0, 1.5fr);
    gap: clamp(var(--space-xl), 6vw, 6rem);
    align-items: start;
  }

  .dds-copy {
    position: sticky;
    top: clamp(var(--space-xl), 12vh, 8rem);
  }

  .dds-atlas-note {
    color: var(--muted);
    font-size: var(--text-sm);
  }

  h2 {
    font-size: var(--text-h2);
    font-weight: 620;
    font-stretch: 118%;
    letter-spacing: -0.015em;
    line-height: 1.05;
  }

  .dds-copy p,
  .flow-inner > p {
    margin-top: var(--space-lg);
  }

  .family-nav {
    margin-top: var(--space-xl);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-xs);
  }

  .family-nav .annot {
    margin-bottom: var(--space-2xs);
  }

  .family-nav a {
    font-weight: 500;
    color: var(--waterline);
    text-decoration: none;
    border-bottom: 1px solid var(--waterline-faint);
  }

  .family-nav a:hover {
    color: var(--overprint-deep);
    border-bottom-color: var(--overprint-deep);
  }

  .family-nav-models {
    margin-top: var(--space-2xs);
    color: var(--overprint-deep) !important;
    border-bottom-color: var(--overprint-faint) !important;
  }

  .sheet-stack {
    display: grid;
    gap: var(--space-md);
  }

  .field-sheet {
    position: relative;
    background: var(--bg);
    border: 1px solid var(--ink);
    padding: var(--space-lg);
  }

  .field-sheet:nth-child(even) {
    margin-left: clamp(0rem, 2vw, 1.35rem);
  }

  .field-sheet::after {
    content: "";
    position: absolute;
    inset: var(--space-sm);
    border: 1px dashed var(--hairline);
    pointer-events: none;
  }

  .field-sheet header {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    gap: var(--space-lg);
    align-items: start;
  }

  h3 {
    font-size: var(--text-h3);
    font-weight: 650;
    font-stretch: 115%;
    line-height: 1.15;
  }

  .field-sheet header code {
    color: var(--overprint-deep);
    font-size: 0.78rem;
    white-space: nowrap;
  }

  .field-sheet dl {
    position: relative;
    z-index: 1;
    margin: var(--space-lg) 0 0;
    display: grid;
    gap: var(--space-sm);
  }

  .field-sheet dl div {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    gap: var(--space-md);
    padding-top: var(--space-sm);
    border-top: 1px solid var(--hairline);
  }

  .field-sheet dt {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .field-sheet dd {
    margin: 0;
    color: var(--ink);
    font-size: var(--text-sm);
    text-wrap: pretty;
  }

  .field-detail {
    position: relative;
    z-index: 1;
    display: inline-block;
    margin-top: var(--space-lg);
    color: var(--waterline);
    text-decoration: none;
  }

  .field-detail:hover {
    color: var(--overprint-deep);
  }

  .flow-inner {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    grid-template-rows: auto 1fr;
    column-gap: clamp(var(--space-xl), 6vw, 6rem);
    row-gap: 0;
    align-items: start;
  }

  .flow-inner > p {
    grid-column: 1;
  }

  .flow-steps {
    grid-column: 2;
    grid-row: 1 / span 2;
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--ink);
    background: var(--bg);
  }

  .flow-steps li {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    column-gap: var(--space-lg);
    padding: var(--space-lg);
  }

  .flow-steps li + li {
    border-top: 1px solid var(--hairline);
  }

  .flow-step {
    color: var(--overprint-deep);
  }

  .flow-steps p {
    margin-top: var(--space-xs);
    color: var(--muted);
    font-size: var(--text-sm);
  }

  @media (max-width: 860px) {
    .dds-inner,
    .flow-inner {
      grid-template-columns: 1fr;
    }

    .flow-inner > p,
    .flow-steps {
      grid-column: auto;
      grid-row: auto;
    }

    .field-sheet:nth-child(even) {
      margin-left: 0;
    }
  }

  @media (max-width: 560px) {
    .field-sheet header,
    .field-sheet dl div,
    .flow-steps li {
      grid-template-columns: 1fr;
    }

    .field-sheet header {
      display: grid;
      gap: var(--space-sm);
    }
  }
</style>
