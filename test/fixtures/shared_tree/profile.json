      "/.channels/A/.channels/_C/indexes/Schema/.metadata",
      "/.channels/A/.channels/_C/indexes/Schema/SchemaString",
      "/.channels/A/.channels/_C/indexes/Forest/.metadata",
      "/.channels/A/.channels/_C/indexes/Forest/contents",
      "/.channels/A/.channels/_C/indexes/DetachedFieldIndex/.metadata",
      "/.channels/A/.channels/_C/indexes/DetachedFieldIndex/DetachedFieldIndexBlob",
      "/gc/__gc_root",
      "/.protocol/attributes",
      "/.protocol/quorumMembers",
      "/.protocol/quorumProposals",
      "/.protocol/quorumValues"
