{
  "formatVersion": 1,
  "reference": {
    "package": "@fluidframework/tree",
    "version": "3.1.0",
    "commit": "c3c5bf0ecd313362e83fe8a02b7d39e7e0736960"
  },
  "service": {
    "implementation": "floodgate",
    "revision": "0eb493fc46d1bb9baf1151a6ccdde93544e057e7",
    "transport": "socket.io",
    "driverPolicies": {
      "enableDiscovery": false,
      "enableLongPollingDowngrade": false,
      "enableRestLess": true,
      "enableWholeSummaryUpload": false
    },
    "deltaStorageRoute": "/deltas/{tenantId}/{documentId}",
    "nativeTransport": {
      "protocol": "phoenix",
      "endpoint": "/socket/websocket",
      "javascript": "watershed/transport_js",
      "erlang": "aquamarine/phoenix"
    }
  },
  "container": {
    "runtimeOptions": {
      "enableRuntimeIdCompressor": "on",
      "compressionOptions": {
        "minimumBatchSizeInBytes": "Infinity",
        "compressionAlgorithm": "lz4"
      },
      "summaryOptions": {
        "summaryConfigOverrides": {
          "state": "disabled"
        }
      }
    },
    "summarizerRuntimeOptions": {
      "enableRuntimeIdCompressor": "on",
      "compressionOptions": {
        "minimumBatchSizeInBytes": "Infinity",
        "compressionAlgorithm": "lz4"
      },
      "summaryOptions": {
        "summaryConfigOverrides": {
          "state": "disableHeuristics",
          "maxAckWaitTime": 15000,
          "maxOpsSinceLastSummary": 7000,
          "initialSummarizerDelayMs": 0
        }
      }
    },
    "oldestSupportedClient": "2.117.0",
    "documentSchema": {
      "version": 1,
      "refSeq": 0,
      "info": {
        "minVersionForCollab": "2.117.0"
      },
      "runtime": {
        "explicitSchemaControl": true,
        "idCompressorMode": "on",
        "opGroupingEnabled": true
      }
    },
    "summaryFormatVersion": 1,
    "gcFeature": 3,
    "summaryPaths": [
      "/.metadata",
      "/.idCompressor",
      "/.recentBatchInfo",
      "/.aliases",
      "/.channels/A/.component",
