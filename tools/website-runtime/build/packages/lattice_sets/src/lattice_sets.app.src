{application, lattice_sets, [
    {vsn, "1.2.0"},
    {applications, [gleam_json,
                    gleam_stdlib,
                    lattice_core]},
    {description, "Grow-only, two-phase, and observed-remove sets for Gleam — conflict-free replicated set types"},
    {modules, [lattice_sets@@main,
               lattice_sets@g_set,
               lattice_sets@or_set,
               lattice_sets@two_p_set]},
    {registered, []}
]}.
