{application, lattice_maps, [
    {vsn, "2.0.0"},
    {applications, [gleam_json,
                    gleam_stdlib,
                    lattice_core,
                    lattice_counters,
                    lattice_registers,
                    lattice_sequence,
                    lattice_sets,
