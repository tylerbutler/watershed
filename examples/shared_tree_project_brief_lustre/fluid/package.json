{
  "name": "shared-tree-project-brief-fluid",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Locally authored Fluid counterpart to the watershed project brief",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/*.test.ts",
    "build": "esbuild src/index.tsx --bundle --format=esm --outfile=dist/index.js",
    "serve": "node serve.mjs",
    "service": "azure-local-service"
  },
  "dependencies": {
    "@fluid-experimental/data-objects": "3.1.0",
    "@fluidframework/azure-client": "3.1.0",
    "@fluidframework/test-runtime-utils": "3.1.0",
    "fluid-framework": "3.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@fluidframework/azure-local-service": "3.1.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.1",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.13.1"
}
