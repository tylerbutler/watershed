{
  "name": "project_room_lustre",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A component-runtime project room built with Lustre and watershed",
  "scripts": {
    "build": "gleam build --target javascript && esbuild build/dev/javascript/project_room_lustre/project_room_lustre.mjs --bundle --format=esm --outfile=dist/project_room_lustre.mjs",
    "serve": "python3 -m http.server 8080"
  },
  "dependencies": {
    "esbuild": "^0.28.1",
    "phoenix": "^1.8.8",
    "ws": "^8.21.0"
  },
  "packageManager": "pnpm@11.13.1"
}
